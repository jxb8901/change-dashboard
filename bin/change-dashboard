#!/usr/bin/env bash
set -u

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFAULT_CONFIG="$ROOT_DIR/config/sample.conf"

usage() {
  printf 'Usage: %s [config-file]\n' "${0##*/}"
  printf '\n'
  printf 'Starts the V1 local change dashboard skeleton.\n'
  printf 'Default config: %s\n' "$DEFAULT_CONFIG"
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    return 0
  fi

  local config_file="${1:-$DEFAULT_CONFIG}"

  if [[ ! -f "$config_file" ]]; then
    printf 'Error: config file not found: %s\n' "$config_file" >&2
    return 1
  fi

  printf 'Change Dashboard skeleton started.\n'
  printf 'Config: %s\n' "$config_file"
  printf 'Next task: implement terminal lifecycle.\n'
}

main "$@"
