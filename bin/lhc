declare -a PANEL_EFFECTIVE_WIDTHS=()
declare -a PANEL_EFFECTIVE_HEIGHTS=()
declare -a PANEL_ORDER=()
declare -a PANEL_OUTPUTS=()
declare -a PANEL_TABLE_COLUMNS=()
declare -a PANEL_WARN_RULES=()
