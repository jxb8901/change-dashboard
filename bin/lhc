declare -a PANEL_COMMAND_CHILD_PID_FILES=()
declare -a PANEL_COMMAND_CHILD_IDENTITY_FILES=()
declare -a PANEL_COMMAND_COLLECTOR_PID_FILES=()
declare -a PANEL_COMMAND_COLLECTOR_IDENTITY_FILES=()
declare -a PANEL_COMMAND_OUTPUT_FILES=()
declare -a PANEL_COMMAND_STATUS_FILES=()
declare -a PANEL_COMMAND_COLLECTED=()
declare -a PANEL_COMMAND_PANEL_INDEXES=()
declare -a PANEL_COMMAND_ALIASES=()
