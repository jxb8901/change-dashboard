REFRESH_INTERVAL=2
TABLE_COLUMN_GAP=1
PANEL_COUNT=0
TERMINAL_ROWS=0
TERMINAL_COLS=0
REQUIRED_ROWS=0
REQUIRED_COLS=0
REQUIRED_TERMINAL_ROWS=0
LAYOUT_ERROR=""
CONDITION_OPERATOR=""
CONDITION_VALUE=""
RAW_LINE_STYLE="OK"
RAW_LINE_KEYWORDS=""
NUMERIC_COMPARE=0
FRAME_KEY_INDEX=0
RESIZE_PENDING=0
DASHBOARD_PAUSED=0
FORCE_FULL_REDRAW=1
RESOLVED_WIDTHS=""
FUNCTION_RESULT=""
PANEL_COMMAND_TEMP_DIR=""
PANEL_COMMAND_JOB_COUNT=0
STREAM_REFRESH_PENDING=0
STREAM_REFRESH_PID=""
AUTO_PANEL_HEIGHT_INDEX=""
CLEANUP_IN_PROGRESS=0
LHC_OWNER_PID="$$"
JOB_TERM_GRACE_ATTEMPTS=10
JOB_KILL_GRACE_ATTEMPTS=10
JOB_GRACE_SLEEP=0.05
STREAM_EVENT_SLEEP=0.05
SSH_CONTROL_PERSIST_SECONDS=30

declare -a SSH_SERVERS=()
