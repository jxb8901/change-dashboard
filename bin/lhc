declare -a SSH_CONTROL_PATHS=()

usage() {
  printf 'Usage: %s [config-file]\n' "${0##*/}"
  printf '\n'
  printf 'Starts the local and SSH change dashboard.\n'
  printf 'Default config: %s\n' "$DEFAULT_CONFIG"
  printf '\n'
  printf 'Options:\n'
  printf '  -h, --help, --usage  Show this help and exit.\n'
}

setup_terminal() {
  TERMINAL_ACTIVE=1
  # Hide the cursor while the dashboard owns the terminal.
  printf '\033[?25l'
}

cleanup_terminal() {
  cleanup_panel_commands
  if [[ "$TERMINAL_ACTIVE" -eq 1 ]]; then
    # Show the cursor again before returning control to the shell.
    printf '\033[?25h'
    # Reset terminal text attributes such as color or bold.
    printf '\033[0m'
    printf '\n'
    TERMINAL_ACTIVE=0
  fi
}

get_process_identity() {
  local pid="$1"

  ps -p "$pid" -o lstart= -o command= 2>/dev/null | sed 's/^[[:space:]]*//'
}

get_process_parent_pid() {
  local pid="$1"

  ps -p "$pid" -o ppid= 2>/dev/null | tr -d '[:space:]'
}

process_is_running() {
  local pid="$1" state

  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  state="$(ps -p "$pid" -o stat= 2>/dev/null | tr -d '[:space:]')"
  [[ -n "$state" && "$state" != *Z* ]]
}

process_belongs_to() {
  local pid="$1" expected_parent="$2" expected_identity="$3"
  local actual_parent actual_identity

  process_is_running "$pid" || return 1
  actual_parent="$(get_process_parent_pid "$pid")"
  [[ -n "$actual_parent" && "$actual_parent" == "$expected_parent" ]] || return 1
  # During the short STARTING window the wrapper may have published its PID
  # before ps can return the identity string. The live parent relationship is
  # the safe fallback for that one window; once an identity is recorded it is
  # always compared to prevent PID reuse from being signalled.
  [[ -z "$expected_identity" ]] && return 0
  actual_identity="$(get_process_identity "$pid")"
  [[ "$actual_identity" == "$expected_identity" ]]
}

read_pid_file() {
  local file="$1" pid=""

  if [[ -s "$file" ]]; then
    IFS= read -r pid <"$file" || true
  fi
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  FUNCTION_RESULT="$pid"
}

get_owned_job_pid() {
  local job="$1" role="$2"
  local wrapper_pid="${PANEL_COMMAND_PIDS[$job]:-}"
  local pid_file="" identity_file="" pid="" identity=""

  case "$role" in
    wrapper)
      identity="${PANEL_COMMAND_WRAPPER_STARTS[$job]:-}"
      if process_belongs_to "$wrapper_pid" "$LHC_OWNER_PID" "$identity"; then
        FUNCTION_RESULT="$wrapper_pid"
        return 0
      fi
      ;;
    child)
      pid_file="${PANEL_COMMAND_CHILD_PID_FILES[$job]:-}"
      identity_file="${PANEL_COMMAND_CHILD_IDENTITY_FILES[$job]:-}"
      ;;
    collector)
      pid_file="${PANEL_COMMAND_COLLECTOR_PID_FILES[$job]:-}"
      identity_file="${PANEL_COMMAND_COLLECTOR_IDENTITY_FILES[$job]:-}"
      ;;
    *)
      return 1
      ;;
  esac

  [[ -n "$pid_file" && -s "$pid_file" ]] || return 1
  read_pid_file "$pid_file" || return 1
  pid="$FUNCTION_RESULT"
  [[ -n "$identity_file" && -s "$identity_file" ]] || return 1
  identity="$(<"$identity_file")"
  if process_belongs_to "$pid" "$wrapper_pid" "$identity"; then
    FUNCTION_RESULT="$pid"
    return 0
  fi
  return 1
}

signal_owned_job_processes() {
  local job="$1" signal="$2" include_wrapper="${3:-1}" role pid

  for role in child collector; do
    if get_owned_job_pid "$job" "$role"; then
      pid="$FUNCTION_RESULT"
      kill -"$signal" "$pid" 2>/dev/null || true
    fi
  done
  if [[ "$include_wrapper" -eq 1 ]] && get_owned_job_pid "$job" wrapper; then
    pid="$FUNCTION_RESULT"
    kill -"$signal" "$pid" 2>/dev/null || true
  fi
}

job_has_owned_child_process() {
  local job="$1" role

  for role in child collector; do
    if get_owned_job_pid "$job" "$role"; then
      return 0
    fi
  done
  return 1
}

job_has_owned_wrapper_process() {
  get_owned_job_pid "$1" wrapper
}

wait_for_job_children() {
  local attempts="$1" job active

  for ((attempts = attempts; attempts > 0; attempts--)); do
    active=0
    for job in "${!PANEL_COMMAND_PIDS[@]}"; do
      [[ "${PANEL_COMMAND_STATES[$job]:-}" != "REAPED" ]] || continue
      if job_has_owned_child_process "$job"; then
        active=1
        break
      fi
    done
    (( active == 0 )) && return 0
    sleep "$JOB_GRACE_SLEEP"
  done
  return 1
}

wait_for_job_wrappers() {
  local attempts="$1" job active

  for ((attempts = attempts; attempts > 0; attempts--)); do
    active=0
    for job in "${!PANEL_COMMAND_PIDS[@]}"; do
      [[ "${PANEL_COMMAND_STATES[$job]:-}" != "REAPED" ]] || continue
      if job_has_owned_wrapper_process "$job"; then
        active=1
        break
      fi
    done
    (( active == 0 )) && return 0
    sleep "$JOB_GRACE_SLEEP"
  done
  return 1
}

reap_job_wrappers() {
  local job pid

  for job in "${!PANEL_COMMAND_PIDS[@]}"; do
    pid="${PANEL_COMMAND_PIDS[$job]:-}"
    if [[ -n "$pid" ]] && ! process_is_running "$pid"; then
      wait "$pid" 2>/dev/null || true
    fi
  done
}

close_ssh_control_master() {
  local index="$1" helper_pid attempts

  (
    ssh -T \
      -o BatchMode=yes \
      -o ConnectTimeout=1 \
      -o ControlPath="${SSH_CONTROL_PATHS[$index]}" \
      -O exit \
      "${SSH_CONTROL_TARGETS[$index]}" >/dev/null 2>&1 || true
  ) &
  helper_pid=$!
  for ((attempts = JOB_TERM_GRACE_ATTEMPTS; attempts > 0; attempts--)); do
    process_is_running "$helper_pid" || break
    sleep "$JOB_GRACE_SLEEP"
  done
  if process_is_running "$helper_pid"; then
    kill -KILL "$helper_pid" 2>/dev/null || true
  fi
  # Never turn the final reap into an unbounded wait. A normal child (or a
  # zombie that has already exited) is safe to reap; an uninterruptible helper
  # is left for the operating system rather than blocking dashboard shutdown.
  if ! process_is_running "$helper_pid"; then
    wait "$helper_pid" 2>/dev/null || true
  fi
}

cleanup_panel_commands() {
  local index job file

  (( CLEANUP_IN_PROGRESS == 0 )) || return 0
  CLEANUP_IN_PROGRESS=1

  # Signal the real command and collector first while their wrapper still
  # proves the parent/identity relationship. The wrapper trap is a bounded
  # fallback for jobs that have not published their child PID yet.
  for job in "${!PANEL_COMMAND_PIDS[@]}"; do
    [[ "${PANEL_COMMAND_STATES[$job]:-}" != "REAPED" ]] || continue
    signal_owned_job_processes "$job" TERM 0 2>/dev/null || true
    if ! job_has_owned_child_process "$job"; then
      if get_owned_job_pid "$job" wrapper; then
        kill -TERM "$FUNCTION_RESULT" 2>/dev/null || true
      fi
    fi
  done
  wait_for_job_children "$JOB_TERM_GRACE_ATTEMPTS" || true

  # A command that ignores TERM receives KILL before its wrapper is stopped.
  # This keeps the recorded parent relationship valid and avoids signalling a
  # reused PID after the wrapper has exited.
  for job in "${!PANEL_COMMAND_PIDS[@]}"; do
    [[ "${PANEL_COMMAND_STATES[$job]:-}" != "REAPED" ]] || continue
    signal_owned_job_processes "$job" KILL 0 2>/dev/null || true
  done
  wait_for_job_children "$JOB_KILL_GRACE_ATTEMPTS" || true

  # All known children have had a bounded TERM/KILL opportunity. Stop and reap
  # the wrappers without an unbounded wait.
  for job in "${!PANEL_COMMAND_PIDS[@]}"; do
    [[ "${PANEL_COMMAND_STATES[$job]:-}" != "REAPED" ]] || continue
    if get_owned_job_pid "$job" wrapper; then
      kill -TERM "$FUNCTION_RESULT" 2>/dev/null || true
    fi
  done
  wait_for_job_wrappers "$JOB_TERM_GRACE_ATTEMPTS" || true
  for job in "${!PANEL_COMMAND_PIDS[@]}"; do
    [[ "${PANEL_COMMAND_STATES[$job]:-}" != "REAPED" ]] || continue
    if get_owned_job_pid "$job" wrapper; then
      kill -KILL "$FUNCTION_RESULT" 2>/dev/null || true
    fi
  done
  wait_for_job_wrappers "$JOB_KILL_GRACE_ATTEMPTS" || true
  reap_job_wrappers

  for index in "${!SSH_CONTROL_TARGETS[@]}"; do
    close_ssh_control_master "$index"
  done

  for index in "${!PANEL_COMMAND_OUTPUT_FILES[@]}"; do
    file="${PANEL_COMMAND_OUTPUT_FILES[$index]:-}"
    if [[ -n "$file" ]]; then
      rm -f "$file" "$file.tmp"
    fi
  done

  for index in "${!PANEL_COMMAND_STATUS_FILES[@]}"; do
    file="${PANEL_COMMAND_STATUS_FILES[$index]:-}"
    [[ -n "$file" ]] && rm -f "$file"
  done

  for index in "${!PANEL_COMMAND_INPUT_FILES[@]}"; do
    file="${PANEL_COMMAND_INPUT_FILES[$index]:-}"
    [[ -n "$file" ]] && rm -f "$file"
  done

  for index in "${!PANEL_COMMAND_ERROR_FILES[@]}"; do
    file="${PANEL_COMMAND_ERROR_FILES[$index]:-}"
    [[ -n "$file" ]] && rm -f "$file"
  done

  for index in "${!PANEL_COMMAND_CHILD_PID_FILES[@]}"; do
    file="${PANEL_COMMAND_CHILD_PID_FILES[$index]:-}"
    [[ -n "$file" ]] && rm -f "$file"
  done

  for index in "${!PANEL_COMMAND_CHILD_IDENTITY_FILES[@]}"; do
    file="${PANEL_COMMAND_CHILD_IDENTITY_FILES[$index]:-}"
    [[ -n "$file" ]] && rm -f "$file"
  done

  for index in "${!PANEL_COMMAND_COLLECTOR_PID_FILES[@]}"; do
    file="${PANEL_COMMAND_COLLECTOR_PID_FILES[$index]:-}"
    [[ -n "$file" ]] && rm -f "$file"
  done

  for index in "${!PANEL_COMMAND_COLLECTOR_IDENTITY_FILES[@]}"; do
    file="${PANEL_COMMAND_COLLECTOR_IDENTITY_FILES[$index]:-}"
    [[ -n "$file" ]] && rm -f "$file"
  done

  for index in "${!PANEL_COMMAND_FIFO_FILES[@]}"; do
    file="${PANEL_COMMAND_FIFO_FILES[$index]:-}"
    [[ -n "$file" ]] && rm -f "$file"
  done

  if [[ -n "$PANEL_COMMAND_TEMP_DIR" ]]; then
    rmdir "$PANEL_COMMAND_TEMP_DIR" 2>/dev/null || true
    PANEL_COMMAND_TEMP_DIR=""
  fi

  PANEL_COMMAND_PIDS=()
  PANEL_COMMAND_WRAPPER_STARTS=()
  PANEL_COMMAND_CHILD_PID_FILES=()
  PANEL_COMMAND_CHILD_IDENTITY_FILES=()
  PANEL_COMMAND_COLLECTOR_PID_FILES=()
  PANEL_COMMAND_COLLECTOR_IDENTITY_FILES=()
  PANEL_COMMAND_OUTPUT_FILES=()
  PANEL_COMMAND_STATUS_FILES=()
  PANEL_COMMAND_COLLECTED=()
  PANEL_COMMAND_PANEL_INDEXES=()
  PANEL_COMMAND_ALIASES=()
  PANEL_COMMAND_TARGETS=()
  PANEL_COMMAND_INPUT_FILES=()
  PANEL_COMMAND_ERROR_FILES=()
  PANEL_COMMAND_EXIT_STATUSES=()
  PANEL_COMMAND_CONTROL_PATHS=()
  PANEL_COMMAND_STREAMS=()
  PANEL_COMMAND_FIFO_FILES=()
  PANEL_COMMAND_LAST_OUTPUTS=()
  PANEL_COMMAND_LAST_STATUSES=()
  PANEL_COMMAND_COUNTS=()
  PANEL_COMMAND_COMPLETED_COUNTS=()
  PANEL_COMMAND_ACTIVE=()
  PANEL_COMMAND_STATES=()
  PANEL_NEXT_RUN_SECONDS=()
  PANEL_COMMAND_START_JOBS=()
  SSH_CONTROL_TARGETS=()
  SSH_CONTROL_PATHS=()
  PANEL_COMMAND_JOB_COUNT=0
  PANEL_COMMAND_SCHEDULER_INITIALIZED=0
  CLEANUP_IN_PROGRESS=0
}

handle_stream_refresh() {
  # Signals only wake the main event loop. Terminal drawing remains in the
  # main shell so a burst of stream output cannot interleave ANSI sequences.
  STREAM_REFRESH_PENDING=1
}

handle_interrupt() {
  cleanup_terminal
  exit 130
}

handle_resize() {
  RESIZE_PENDING=1
}

error() {
  printf 'Error: %s\n' "$*" >&2
}

has_array_index() {
  local array_name="$1"
  local index="$2"

  eval '[[ ${'"$array_name"'['"$index"']+set} ]]'
}

is_positive_integer() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

is_non_negative_integer() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

load_config() {
  local config_file="$1"

  if [[ ! -f "$config_file" ]]; then
    error "config file not found: $config_file"
    return 1
  fi

  REFRESH_INTERVAL=2
  LAYOUT_ERROR=""
  PANEL_COUNT=0
  SSH_SERVERS=()
  PANEL_TITLES=()
  PANEL_COMMANDS=()
  PANEL_SSH_ALIASES=()
  PANEL_STREAM=()
  PANEL_X=()
  PANEL_Y=()
  PANEL_WIDTHS=()
  PANEL_HEIGHTS=()
  PANEL_EFFECTIVE_X=()
  PANEL_EFFECTIVE_Y=()
  PANEL_EFFECTIVE_WIDTHS=()
  PANEL_EFFECTIVE_HEIGHTS=()
  AUTO_PANEL_HEIGHT_INDEX=""
  PANEL_ORDER=()
  PANEL_OUTPUTS=()
  PANEL_TABLE_COLUMNS=()
  PANEL_WARN_RULES=()
  PANEL_ERROR_RULES=()
  PANEL_INFO_RULES=()
  PANEL_TABLE_LAYOUT=()
  PANEL_TABLE_WIDTHS=()
  PANEL_RENDER_MODES=()
  PANEL_STATUSES=()
  PANEL_TABLE_HEADERS=()
  PANEL_TABLE_ROWS=()
  PANEL_TABLE_CELL_STATUSES=()
  PANEL_SSH_FAILURE_ROWS=()
  CURRENT_FRAME_KEYS=()
  CURRENT_FRAME_TEXT=()
  CURRENT_FRAME_STYLES=()
  PREVIOUS_FRAME_KEYS=()
  PREVIOUS_FRAME_TEXT=()
  PREVIOUS_FRAME_STYLES=()
  CURRENT_FRAME_INDEX=()
  PREVIOUS_FRAME_INDEX=()

  # Config is trusted deployment input and may contain shell commands.
  # shellcheck source=/dev/null
  source "$config_file"

  if ! is_positive_integer "$REFRESH_INTERVAL"; then
    error "REFRESH_INTERVAL must be a positive integer"
    return 1
  fi

  validate_config
}

validate_config() {
  local index

  if [[ "${#PANEL_TITLES[@]}" -eq 0 ]]; then
    error "at least one panel must be configured"
    return 1
  fi

  build_panel_model || return 1

  for index in "${!PANEL_TITLES[@]}"; do
    validate_panel "$index" || return 1
  done

  validate_no_extra_panel_indexes PANEL_COMMANDS || return 1
  validate_no_extra_panel_indexes PANEL_X || return 1
  validate_no_extra_panel_indexes PANEL_Y || return 1
  validate_no_extra_panel_indexes PANEL_WIDTHS || return 1
  validate_no_extra_panel_indexes PANEL_HEIGHTS || return 1
  validate_optional_panel_indexes PANEL_TABLE_COLUMNS || return 1
  validate_optional_panel_indexes PANEL_WARN_RULES || return 1
  validate_optional_panel_indexes PANEL_ERROR_RULES || return 1
  validate_optional_panel_indexes PANEL_INFO_RULES || return 1
  validate_optional_panel_indexes PANEL_TABLE_LAYOUT || return 1
  validate_optional_panel_indexes PANEL_TABLE_WIDTHS || return 1
  validate_optional_panel_indexes PANEL_SSH_ALIASES || return 1
  validate_optional_panel_indexes PANEL_STREAM || return 1

  validate_table_configs || return 1
  validate_stream_configs || return 1
  validate_ssh_configs || return 1

  initialize_effective_panel_dimensions
}

validate_stream_configs() {
  local index value layout

  for index in "${!PANEL_STREAM[@]}"; do
    value="${PANEL_STREAM[$index]}"
    if [[ "$value" != "0" && "$value" != "1" ]]; then
      error "PANEL_STREAM[$index] must be 0 or 1"
      return 1
    fi
    if [[ "$value" == "1" ]] && has_array_index PANEL_TABLE_COLUMNS "$index"; then
      layout="${PANEL_TABLE_LAYOUT[$index]:-table}"
      if [[ "$layout" != "table" ]]; then
        error "PANEL_STREAM[$index] supports raw or table layout, not $layout"
        return 1
      fi
    fi
  done
}

validate_no_extra_panel_indexes() {
  local array_name="$1"
  local index

  eval 'for index in "${!'"$array_name"'[@]}"; do
    if ! has_array_index PANEL_TITLES "$index"; then
      error "'"$array_name"'[$index] has no matching PANEL_TITLES[$index]"
      return 1
    fi
  done'
}

validate_optional_panel_indexes() {
  local array_name="$1"
  local index

  eval 'for index in "${!'"$array_name"'[@]}"; do
    if ! has_array_index PANEL_TITLES "$index"; then
      error "'"$array_name"'[$index] has no matching PANEL_TITLES[$index]"
      return 1
    fi
  done'
}

validate_panel() {
  local index="$1"

  require_panel_field PANEL_TITLES "$index" || return 1
  require_panel_field PANEL_COMMANDS "$index" || return 1
  require_panel_field PANEL_X "$index" || return 1
  require_panel_field PANEL_Y "$index" || return 1
  require_panel_field PANEL_WIDTHS "$index" || return 1
  if ! has_array_index PANEL_HEIGHTS "$index"; then
    if [[ "$index" == "${PANEL_ORDER[${#PANEL_ORDER[@]}-1]}" ]]; then
      AUTO_PANEL_HEIGHT_INDEX="$index"
    else
      error "PANEL_HEIGHTS[$index] is required"
      return 1
    fi
  fi

  if [[ -z "${PANEL_TITLES[$index]}" ]]; then
    error "PANEL_TITLES[$index] must not be empty"
    return 1
  fi

  if [[ -z "${PANEL_COMMANDS[$index]}" ]]; then
    error "PANEL_COMMANDS[$index] must not be empty"
    return 1
  fi

  validate_panel_geometry_value "$index" "PANEL_X" "${PANEL_X[$index]}" 0 1 || return 1
  validate_panel_geometry_value "$index" "PANEL_Y" "${PANEL_Y[$index]}" 0 1 || return 1
  validate_panel_geometry_value "$index" "PANEL_WIDTHS" "${PANEL_WIDTHS[$index]}" 1 4 || return 1

  if has_array_index PANEL_HEIGHTS "$index"; then
    validate_panel_geometry_value "$index" "PANEL_HEIGHTS" "${PANEL_HEIGHTS[$index]}" 1 3 || return 1
  fi
}

validate_panel_geometry_value() {
  local index="$1"
  local field="$2"
  local value="$3"
  local percentage_min="$4"
  local integer_min="$5"
  local percentage
  local integer_value

  if [[ "$value" =~ ^[0-9]+%$ ]]; then
    percentage="${value%%%}"
    percentage=$((10#$percentage))
    if (( percentage < percentage_min || percentage > 100 )); then
      error "$field[$index] percentage must be between ${percentage_min}% and 100%"
      return 1
    fi
    return 0
  fi

  if is_positive_integer "$value"; then
    integer_value=$((10#$value))
    (( integer_value >= integer_min )) && return 0
  fi

  if ! is_positive_integer "$value" || (( integer_value < integer_min )); then
    if [[ "$integer_min" -eq 1 ]]; then
      error "$field[$index] must be a positive integer or a percentage between ${percentage_min}% and 100%"
    else
      error "$field[$index] must be at least $integer_min or a percentage between ${percentage_min}% and 100%"
    fi
    return 1
  fi
}

validate_table_configs() {
  local index

  for index in "${!PANEL_TABLE_COLUMNS[@]}"; do
    validate_table_columns "$index" || return 1
    validate_rule_list "$index" "WARN" "${PANEL_WARN_RULES[$index]:-}" || return 1
    validate_rule_list "$index" "ERROR" "${PANEL_ERROR_RULES[$index]:-}" || return 1
    validate_rule_list "$index" "INFO" "${PANEL_INFO_RULES[$index]:-}" || return 1
    validate_table_layout "$index" || return 1
  done

  for index in "${!PANEL_WARN_RULES[@]}"; do
    if ! has_array_index PANEL_TABLE_COLUMNS "$index"; then
      validate_raw_rule_list "$index" "WARN" "${PANEL_WARN_RULES[$index]:-}" || return 1
    fi
  done

  for index in "${!PANEL_ERROR_RULES[@]}"; do
    if ! has_array_index PANEL_TABLE_COLUMNS "$index"; then
      validate_raw_rule_list "$index" "ERROR" "${PANEL_ERROR_RULES[$index]:-}" || return 1
    fi
  done

  for index in "${!PANEL_INFO_RULES[@]}"; do
    if ! has_array_index PANEL_TABLE_COLUMNS "$index"; then
      validate_raw_rule_list "$index" "INFO" "${PANEL_INFO_RULES[$index]:-}" || return 1
    fi
  done


  for index in "${!PANEL_TABLE_LAYOUT[@]}"; do
    if ! has_array_index PANEL_TABLE_COLUMNS "$index"; then
      error "PANEL_TABLE_LAYOUT[$index] requires PANEL_TABLE_COLUMNS[$index]"
      return 1
    fi
  done

  for index in "${!PANEL_TABLE_WIDTHS[@]}"; do
    if ! has_array_index PANEL_TABLE_COLUMNS "$index"; then
      error "PANEL_TABLE_WIDTHS[$index] requires PANEL_TABLE_COLUMNS[$index]"
      return 1
    fi
  done
}

validate_raw_rule_list() {
  local index="$1" severity="$2" rules="$3" rule field condition

  for rule in $rules; do
    if [[ "$rule" != MESSAGE:* ]]; then
      error "$severity raw rule must use MESSAGE:condition format for panel $index: $rule"
      return 1
    fi
    field="${rule%%:*}"
    condition="${rule#*:}"
    parse_condition "$condition" || {
      error "$severity raw rule has invalid condition for panel $index: $condition"
      return 1
    }
    if [[ "$CONDITION_OPERATOR" != '~' && "$CONDITION_OPERATOR" != '!~' ]] ||
       [[ -z "$CONDITION_VALUE" ]]; then
      error "$severity raw rule only supports non-empty ~ or !~ conditions for panel $index"
      return 1
    fi
  done
}

validate_ssh_configs() {
  local index record alias target aliases panel_alias seen_aliases=" " alias_count
  local column_count column

  for index in "${!SSH_SERVERS[@]}"; do
    record="${SSH_SERVERS[$index]}"
    if [[ "$record" != *"|"* ]]; then
      error "SSH_SERVERS[$index] must use alias|target format"
      return 1
    fi

    alias="${record%%|*}"
    target="${record#*|}"
    if [[ -z "$alias" || -z "$target" || "$target" == *"|"* ]]; then
      error "SSH_SERVERS[$index] must contain one non-empty alias and target"
      return 1
    fi
    if contains_whitespace "$alias" || contains_whitespace "$target"; then
      error "SSH_SERVERS[$index] alias and target must not contain whitespace"
      return 1
    fi
    if [[ ! "$alias" =~ ^[A-Za-z0-9_.-]+$ ]]; then
      error "SSH_SERVERS[$index] alias may contain only letters, numbers, dot, underscore, and dash"
      return 1
    fi
    if [[ "$alias" == -* || "$target" == -* ]]; then
      error "SSH_SERVERS[$index] alias and target must not start with dash"
      return 1
    fi
    if [[ "$seen_aliases" == *" $alias "* ]]; then
      error "duplicate SSH server alias: $alias"
      return 1
    fi
    seen_aliases="${seen_aliases}${alias} "
  done

  for index in "${!PANEL_SSH_ALIASES[@]}"; do
    aliases="${PANEL_SSH_ALIASES[$index]}"
    if [[ -z "$aliases" ]]; then
      error "PANEL_SSH_ALIASES[$index] must not be empty"
      return 1
    fi
    if [[ "$aliases" =~ [^A-Za-z0-9_.[:space:]-] ]]; then
      error "PANEL_SSH_ALIASES[$index] contains an invalid alias character"
      return 1
    fi

    seen_aliases=" "
    alias_count=0
    for panel_alias in $aliases; do
      if [[ "$seen_aliases" == *" $panel_alias "* ]]; then
        error "duplicate SSH alias for panel $index: $panel_alias"
        return 1
      fi
      resolve_ssh_target "$panel_alias"
      if [[ -z "$FUNCTION_RESULT" ]]; then
        error "unknown SSH alias for panel $index: $panel_alias"
        return 1
      fi
      seen_aliases="${seen_aliases}${panel_alias} "
      alias_count=$((alias_count + 1))
    done
    if (( alias_count == 0 )); then
      error "PANEL_SSH_ALIASES[$index] must contain at least one alias"
      return 1
    fi

    if has_array_index PANEL_TABLE_COLUMNS "$index"; then
      column_count=0
      for column in ${PANEL_TABLE_COLUMNS[$index]}; do
        column_count=$((column_count + 1))
      done
      if (( column_count < 2 )); then
        error "SSH table panel $index requires a server column and at least one command-output column"
        return 1
      fi
    fi
  done
}

contains_whitespace() {
  [[ "$1" == *" "* || "$1" == *$'\t'* || "$1" == *$'\n'* || "$1" == *$'\r'* ]]
}

resolve_ssh_target() {
  local target_alias="$1"
  local index record alias

  FUNCTION_RESULT=""
  for index in "${!SSH_SERVERS[@]}"; do
    record="${SSH_SERVERS[$index]}"
    alias="${record%%|*}"
    if [[ "$alias" == "$target_alias" ]]; then
      FUNCTION_RESULT="${record#*|}"
      return 0
    fi
  done
}

validate_table_layout() {
  local index="$1"
  local layout="${PANEL_TABLE_LAYOUT[$index]:-table}"
  local widths="${PANEL_TABLE_WIDTHS[$index]:-}"
  local expected=0
  local count=0
  local width
  local column

  if [[ "$layout" != "table" && "$layout" != "transpose" ]]; then
    error "PANEL_TABLE_LAYOUT[$index] must be table or transpose"
    return 1
  fi

  if [[ "$layout" == "transpose" ]]; then
    expected=2
  else
    for column in ${PANEL_TABLE_COLUMNS[$index]}; do
      expected=$((expected + 1))
    done
  fi
  [[ -z "$widths" ]] && return 0

  for width in $widths; do
    if ! is_positive_integer "$width"; then
      error "PANEL_TABLE_WIDTHS[$index] values must be positive integers"
      return 1
    fi
    count=$((count + 1))
  done

  if (( count != expected && count != expected - 1 )); then
    error "PANEL_TABLE_WIDTHS[$index] requires $expected widths, or omits only the final width, for $layout layout"
    return 1
  fi
}

validate_resolved_table_layout() {
  local index="$1"
  local layout="${PANEL_TABLE_LAYOUT[$index]:-table}"
  local widths="${PANEL_TABLE_WIDTHS[$index]:-}"
  local expected=0
  local count=0
  local total=0
  local width
  local column
  local content_width=$((PANEL_EFFECTIVE_WIDTHS[index] - 2))
  local gap_total=0
  local required_width=0

  if [[ "$layout" == "transpose" ]]; then
    expected=2
  else
    for column in ${PANEL_TABLE_COLUMNS[$index]}; do
      expected=$((expected + 1))
    done
  fi
  gap_total=$(((expected - 1) * TABLE_COLUMN_GAP))

  if [[ -z "$widths" ]]; then
    if (( (content_width - gap_total) / expected < 1 )); then
      error "panel $index is too narrow for $expected table columns"
      return 1
    fi
    return 0
  fi

  for width in $widths; do
    count=$((count + 1))
    total=$((total + width))
  done

  if (( count == expected - 1 )); then
    required_width=$((total + gap_total + 1))
    if (( required_width > content_width )); then
      error "PANEL_TABLE_WIDTHS[$index] leaves no space for the final width"
      return 1
    fi
  fi

  required_width=$((total + gap_total))
  if (( required_width > content_width )); then
    error "PANEL_TABLE_WIDTHS[$index] requires $required_width columns including gaps, but panel content width is $content_width"
    return 1
  fi
}

validate_table_columns() {
  local index="$1"
  local columns="${PANEL_TABLE_COLUMNS[$index]}"
  local column
  local seen=" "

  if [[ -z "$columns" ]]; then
    error "PANEL_TABLE_COLUMNS[$index] must not be empty"
    return 1
  fi

  for column in $columns; do
    if [[ "$column" == *:* ]]; then
      error "table column must not contain colon: $column"
      return 1
    fi

    if [[ "$seen" == *" $column "* ]]; then
      error "duplicate table column in PANEL_TABLE_COLUMNS[$index]: $column"
      return 1
    fi

    seen="${seen}${column} "
  done
}

validate_rule_list() {
  local index="$1"
  local severity="$2"
  local rules="$3"
  local rule
  local column
  local condition

  for rule in $rules; do
    if [[ "$rule" != *:* ]]; then
      error "$severity rule must use column:condition format: $rule"
      return 1
    fi

    column="${rule%%:*}"
    condition="${rule#*:}"

    if ! table_has_column "$index" "$column"; then
      error "$severity rule references unknown column for panel $index: $column"
      return 1
    fi

    if ! validate_condition "$condition"; then
      error "$severity rule has invalid condition for panel $index: $condition"
      return 1
    fi
  done
}

table_has_column() {
  local index="$1"
  local target="$2"
  local column

  for column in ${PANEL_TABLE_COLUMNS[$index]}; do
    if [[ "$column" == "$target" ]]; then
      return 0
    fi
  done

  return 1
}

validate_condition() {
  local condition="$1"

  parse_condition "$condition" || return 1
  if [[ -z "$CONDITION_VALUE" ]]; then
    return 1
  fi

  case "$CONDITION_OPERATOR" in
    '>'|'>='|'<'|'<='|'=='|'!='|'~'|'!~')
      return 0
      ;;
  esac

  return 1
}

parse_condition() {
  local condition="$1"
  local operator
  local value

  case "$condition" in
    '!~'*) operator='!~'; value="${condition:2}" ;;
    '~'*) operator='~'; value="${condition:1}" ;;
    '>='*) operator='>='; value="${condition#>=}" ;;
    '<='*) operator='<='; value="${condition#<=}" ;;
    '=='*) operator='=='; value="${condition#==}" ;;
    '!='*) operator='!='; value="${condition#!=}" ;;
    '>'*) operator='>'; value="${condition#>}" ;;
    '<'*) operator='<'; value="${condition#<}" ;;
    *) return 1 ;;
  esac

  CONDITION_OPERATOR="$operator"
  CONDITION_VALUE="$value"
}

require_panel_field() {
  local array_name="$1"
  local index="$2"

  if ! has_array_index "$array_name" "$index"; then
    error "$array_name[$index] is required"
    return 1
  fi
}

build_panel_model() {
  local index

  PANEL_ORDER=()
  for index in "${!PANEL_TITLES[@]}"; do
    if ! is_non_negative_integer "$index"; then
      error "panel index must be a non-negative integer: $index"
      return 1
    fi
    PANEL_ORDER+=("$index")
  done

  PANEL_COUNT="${#PANEL_ORDER[@]}"
}

initialize_effective_panel_dimensions() {
  local index

  PANEL_EFFECTIVE_X=()
  PANEL_EFFECTIVE_Y=()
  PANEL_EFFECTIVE_WIDTHS=()
  PANEL_EFFECTIVE_HEIGHTS=()
  for index in "${PANEL_ORDER[@]}"; do
    PANEL_EFFECTIVE_X[$index]="${PANEL_X[$index]}"
    PANEL_EFFECTIVE_Y[$index]="${PANEL_Y[$index]}"
    PANEL_EFFECTIVE_WIDTHS[$index]="${PANEL_WIDTHS[$index]}"
    if has_array_index PANEL_HEIGHTS "$index"; then
      PANEL_EFFECTIVE_HEIGHTS[$index]="${PANEL_HEIGHTS[$index]}"
    fi
  done
}

ensure_effective_panel_dimensions() {
  local index="$1"

  if ! has_array_index PANEL_EFFECTIVE_X "$index"; then
    PANEL_EFFECTIVE_X[$index]="${PANEL_X[$index]:-0}"
  fi
  if ! has_array_index PANEL_EFFECTIVE_Y "$index"; then
    PANEL_EFFECTIVE_Y[$index]="${PANEL_Y[$index]:-0}"
  fi
  if ! has_array_index PANEL_EFFECTIVE_WIDTHS "$index"; then
    PANEL_EFFECTIVE_WIDTHS[$index]="${PANEL_WIDTHS[$index]:-0}"
  fi
  if ! has_array_index PANEL_EFFECTIVE_HEIGHTS "$index" && has_array_index PANEL_HEIGHTS "$index"; then
    PANEL_EFFECTIVE_HEIGHTS[$index]="${PANEL_HEIGHTS[$index]:-0}"
  fi
}

calculate_required_terminal_size() {
  local index
  local panel_right
  local panel_bottom

  REQUIRED_COLS=0
  REQUIRED_ROWS=0

  for index in "${PANEL_ORDER[@]}"; do
    panel_right=$((PANEL_EFFECTIVE_X[index] + PANEL_EFFECTIVE_WIDTHS[index] - 1))
    panel_bottom=$((PANEL_EFFECTIVE_Y[index] + PANEL_EFFECTIVE_HEIGHTS[index] - 1))

    if (( panel_right > REQUIRED_COLS )); then
      REQUIRED_COLS="$panel_right"
    fi

    if (( panel_bottom > REQUIRED_ROWS )); then
      REQUIRED_ROWS="$panel_bottom"
    fi
  done

  # Reserve one row below the panels for the refresh and exit footer.
  REQUIRED_TERMINAL_ROWS=$((REQUIRED_ROWS + 1))
}

resolve_panel_value() {
  local value="$1"
  local axis_size="$2"
  local position_offset="$3"
  local percentage

  if [[ "$value" == *% ]]; then
    percentage="${value%%%}"
    percentage=$((10#$percentage))
    FUNCTION_RESULT=$(( (10#$percentage * axis_size) / 100 + position_offset ))
  else
    FUNCTION_RESULT=$((10#$value))
  fi
}

resolve_panel_dimensions() {
  local index usable_rows height

  usable_rows=$((TERMINAL_ROWS - 1))
  PANEL_EFFECTIVE_X=()
  PANEL_EFFECTIVE_Y=()
  PANEL_EFFECTIVE_WIDTHS=()
  PANEL_EFFECTIVE_HEIGHTS=()

  for index in "${PANEL_ORDER[@]}"; do
    resolve_panel_value "${PANEL_X[$index]}" "$TERMINAL_COLS" 1
    PANEL_EFFECTIVE_X[$index]="$FUNCTION_RESULT"

    resolve_panel_value "${PANEL_Y[$index]}" "$usable_rows" 1
    PANEL_EFFECTIVE_Y[$index]="$FUNCTION_RESULT"

    resolve_panel_value "${PANEL_WIDTHS[$index]}" "$TERMINAL_COLS" 0
    PANEL_EFFECTIVE_WIDTHS[$index]="$FUNCTION_RESULT"

    if has_array_index PANEL_HEIGHTS "$index"; then
      resolve_panel_value "${PANEL_HEIGHTS[$index]}" "$usable_rows" 0
      PANEL_EFFECTIVE_HEIGHTS[$index]="$FUNCTION_RESULT"
    else
      height=$((usable_rows - PANEL_EFFECTIVE_Y[index] + 1))
      (( height < 3 )) && height=3
      PANEL_EFFECTIVE_HEIGHTS[$index]="$height"
    fi
  done
}

validate_effective_panel_layout() {
  local index panel_right panel_bottom
  local usable_rows=$((TERMINAL_ROWS - 1))

  LAYOUT_ERROR=""
  for index in "${PANEL_ORDER[@]}"; do
    if (( PANEL_EFFECTIVE_WIDTHS[index] < 4 )); then
      LAYOUT_ERROR="panel $index width resolves to ${PANEL_EFFECTIVE_WIDTHS[index]}, minimum is 4"
      return 1
    fi
    if (( PANEL_EFFECTIVE_HEIGHTS[index] < 3 )); then
      LAYOUT_ERROR="panel $index height resolves to ${PANEL_EFFECTIVE_HEIGHTS[index]}, minimum is 3"
      return 1
    fi

    panel_right=$((PANEL_EFFECTIVE_X[index] + PANEL_EFFECTIVE_WIDTHS[index] - 1))
    panel_bottom=$((PANEL_EFFECTIVE_Y[index] + PANEL_EFFECTIVE_HEIGHTS[index] - 1))
    if (( PANEL_EFFECTIVE_X[index] < 1 || panel_right > TERMINAL_COLS )); then
      LAYOUT_ERROR="panel $index is outside terminal width after resolving geometry"
      return 1
    fi
    if (( PANEL_EFFECTIVE_Y[index] < 1 || panel_bottom > usable_rows )); then
      LAYOUT_ERROR="panel $index is outside dashboard height after resolving geometry"
      return 1
    fi

    if has_array_index PANEL_TABLE_COLUMNS "$index" &&
       ! validate_resolved_table_layout "$index" >/dev/null 2>&1; then
      LAYOUT_ERROR="panel $index has an invalid table layout for its resolved width"
      return 1
    fi
  done
}

read_terminal_size() {
  local size

  size="$(stty size 2>/dev/null || true)"
  if [[ -n "$size" ]]; then
    TERMINAL_ROWS="${size%% *}"
    TERMINAL_COLS="${size##* }"
  else
    TERMINAL_ROWS="${LINES:-0}"
    TERMINAL_COLS="${COLUMNS:-0}"
  fi

  if ! is_positive_integer "$TERMINAL_ROWS" || ! is_positive_integer "$TERMINAL_COLS"; then
    error "unable to determine terminal size"
    return 1
  fi
}

validate_terminal_size() {
  read_terminal_size || return 1
  resolve_panel_dimensions
  calculate_required_terminal_size

  if (( TERMINAL_COLS < REQUIRED_COLS || TERMINAL_ROWS < REQUIRED_TERMINAL_ROWS )); then
    error "terminal too small: need ${REQUIRED_COLS}x${REQUIRED_TERMINAL_ROWS}, have ${TERMINAL_COLS}x${TERMINAL_ROWS}"
    return 1
  fi

  if ! validate_effective_panel_layout; then
    error "$LAYOUT_ERROR"
    return 1
  fi
}

resolve_auto_panel_dimensions() {
  resolve_panel_dimensions
}

move_cursor() {
  local row="$1"
  local col="$2"

  # Move the cursor to the requested one-based terminal row and column.
  printf '\033[%s;%sH' "$row" "$col"
}

repeat_char() {
  local char="$1"
  local count="$2"
  local output=""

  while (( count > 0 )); do
    output="${output}${char}"
    count=$((count - 1))
  done

  FUNCTION_RESULT="$output"
}

clip_text() {
  local text="$1"
  local width="$2"

  FUNCTION_RESULT="${text:0:width}"
}

draw_panel_border() {
  local x="$1"
  local y="$2"
  local width="$3"
  local height="$4"
  local row
  local inner_width=$((width - 2))

  # Move to the panel's top-left corner before drawing its top border.
  move_cursor "$y" "$x"
  repeat_char '-' "$inner_width"
  printf '+%s+' "$FUNCTION_RESULT"

  row=$((y + 1))
  while (( row < y + height - 1 )); do
    # Move to the left edge of this panel row.
    move_cursor "$row" "$x"
    printf '|'
    # Move to the right edge of this panel row.
    move_cursor "$row" "$((x + width - 1))"
    printf '|'
    row=$((row + 1))
  done

  # Move to the panel's bottom-left corner before drawing its bottom border.
  move_cursor "$((y + height - 1))" "$x"
  repeat_char '-' "$inner_width"
  printf '+%s+' "$FUNCTION_RESULT"
}

  status_sequence() {
  FUNCTION_RESULT=""
  [[ -n "${NO_COLOR:-}" ]] && return 0
  case "$1" in
    # Set white foreground text on a red background for errors and failures.
    ERROR|FAILED) FUNCTION_RESULT=$'\033[37;41m' ;;
    # Set black foreground text on a yellow background for warnings.
    WARN) FUNCTION_RESULT=$'\033[30;43m' ;;
    # Set black foreground text on a green background for informational values.
    INFO) FUNCTION_RESULT=$'\033[30;42m' ;;
  esac
}

format_cell() {
  local text="$1"
  local width="$2"
  local alignment="${3:-left}"
  local clipped="$text"

  if (( ${#text} > width )); then
    if is_number "$text"; then
      repeat_char '#' "$width"
      return
    fi

    if (( width <= 0 )); then
      clipped=""
    elif (( width == 1 )); then
      clipped="."
    else
      clipped="${text:0:$((width - 1))}."
    fi
  fi

  if [[ "$alignment" == "right" ]]; then
    printf -v FUNCTION_RESULT '%*s' "$width" "$clipped"
  else
    printf -v FUNCTION_RESULT '%-*s' "$width" "$clipped"
  fi
}

frame_add() {
  local row="$1" col="$2" width="$3" text="$4"
  local style="${5:-OK}" alignment="${6:-left}"
  local position="${#CURRENT_FRAME_KEYS[@]}"

  CURRENT_FRAME_KEYS[$position]="$row:$col:$width"
  format_cell "$text" "$width" "$alignment"
  CURRENT_FRAME_TEXT[$position]="$FUNCTION_RESULT"
  CURRENT_FRAME_STYLES[$position]="$style"
  frame_key_index "${CURRENT_FRAME_KEYS[$position]}"
  CURRENT_FRAME_INDEX[$FRAME_KEY_INDEX]=$position
}

frame_key_index() {
  local key="$1" row remainder col width base
  row="${key%%:*}"
  remainder="${key#*:}"
  col="${remainder%%:*}"
  width="${key##*:}"
  base=$((REQUIRED_COLS + 1))
  FRAME_KEY_INDEX=$((((row * base) + col) * base + width))
}

draw_frame_value() {
  local key="$1" text="$2" style="$3"
  local row="${key%%:*}" remainder="${key#*:}" sequence
  local col="${remainder%%:*}"

  # Move directly to the changed frame cell before repainting it.
  move_cursor "$row" "$col"
  status_sequence "$style"
  sequence="$FUNCTION_RESULT"
  if [[ -n "$sequence" ]]; then
    # Apply the status style, print the cell, then reset all ANSI attributes.
    printf '%s%s\033[0m' "$sequence" "$text"
  else
    printf '%s' "$text"
  fi
}

render_frame_diff() {
  local i previous key lookup

  for i in "${!PREVIOUS_FRAME_KEYS[@]}"; do
    key="${PREVIOUS_FRAME_KEYS[$i]}"
    frame_key_index "$key"
    lookup="$FRAME_KEY_INDEX"
    if [[ -z "${CURRENT_FRAME_INDEX[$lookup]+set}" ]]; then
      repeat_char ' ' "${key##*:}"
      draw_frame_value "$key" "$FUNCTION_RESULT" OK
    fi
  done

  for i in "${!CURRENT_FRAME_KEYS[@]}"; do
    key="${CURRENT_FRAME_KEYS[$i]}"
    frame_key_index "$key"
    lookup="$FRAME_KEY_INDEX"
    previous="${PREVIOUS_FRAME_INDEX[$lookup]:-}"
    if (( FORCE_FULL_REDRAW == 1 )) || [[ -z "${PREVIOUS_FRAME_INDEX[$lookup]+set}" ]] ||
       [[ "${CURRENT_FRAME_TEXT[$i]}" != "${PREVIOUS_FRAME_TEXT[$previous]}" ]] ||
       [[ "${CURRENT_FRAME_STYLES[$i]}" != "${PREVIOUS_FRAME_STYLES[$previous]}" ]]; then
      draw_frame_value "$key" "${CURRENT_FRAME_TEXT[$i]}" "${CURRENT_FRAME_STYLES[$i]}"
    fi
  done

  PREVIOUS_FRAME_KEYS=("${CURRENT_FRAME_KEYS[@]}")
  PREVIOUS_FRAME_TEXT=("${CURRENT_FRAME_TEXT[@]}")
  PREVIOUS_FRAME_STYLES=("${CURRENT_FRAME_STYLES[@]}")
  PREVIOUS_FRAME_INDEX=()
  for i in "${!PREVIOUS_FRAME_KEYS[@]}"; do
    frame_key_index "${PREVIOUS_FRAME_KEYS[$i]}"
    PREVIOUS_FRAME_INDEX[$FRAME_KEY_INDEX]=$i
  done
  FORCE_FULL_REDRAW=0
}

get_word_at_position() {
  local words="$1" target="$2" position=0 word
  FUNCTION_RESULT=""
  for word in $words; do
    if (( position == target )); then FUNCTION_RESULT="$word"; return; fi
    position=$((position + 1))
  done
}

get_line_at_position() {
  local content="$1" target="$2" position=0 line
  FUNCTION_RESULT=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if (( position == target )); then FUNCTION_RESULT="$line"; return; fi
    position=$((position + 1))
  done <<< "$content"
}

resolve_table_widths() {
  local index="$1" layout="${PANEL_TABLE_LAYOUT[$1]:-table}"
  ensure_effective_panel_dimensions "$index"
  local content_width=$((PANEL_EFFECTIVE_WIDTHS[index] - 2))
  local count=0 specified_count=0 width column result="" available_width fixed_total=0

  if [[ -n "${PANEL_TABLE_WIDTHS[$index]:-}" ]]; then
    if [[ "$layout" == "transpose" ]]; then
      count=2
    else
      for column in ${PANEL_TABLE_COLUMNS[$index]}; do count=$((count + 1)); done
    fi
    for width in ${PANEL_TABLE_WIDTHS[$index]}; do
      result="${result}${width} "
      fixed_total=$((fixed_total + width))
      specified_count=$((specified_count + 1))
    done
    if (( specified_count == count - 1 )); then
      width=$((content_width - (count - 1) * TABLE_COLUMN_GAP - fixed_total))
      result="${result}${width}"
    else
      result="${result% }"
    fi
    RESOLVED_WIDTHS="$result"
    return
  fi
  if [[ "$layout" == "transpose" ]]; then
    count=2
  else
    for column in ${PANEL_TABLE_COLUMNS[$index]}; do count=$((count + 1)); done
  fi
  available_width=$((content_width - (count - 1) * TABLE_COLUMN_GAP))
  width=$((available_width / count))
  while (( count > 0 )); do
    result="${result}${width} "
    count=$((count - 1))
  done
  RESOLVED_WIDTHS="${result% }"
}

build_raw_frame() {
  local index="$1" row=0 line
  ensure_effective_panel_dimensions "$index"
  local x=$((PANEL_EFFECTIVE_X[index] + 1)) y=$((PANEL_EFFECTIVE_Y[index] + 1))
  local width=$((PANEL_EFFECTIVE_WIDTHS[index] - 2)) height=$((PANEL_EFFECTIVE_HEIGHTS[index] - 2))
  local content="${PANEL_OUTPUTS[$index]:-No data}"

  while (( row < height )); do
    get_line_at_position "$content" "$row"
    line="$FUNCTION_RESULT"
    render_raw_line "$index" "$((y + row))" "$x" "$width" "$line"
    row=$((row + 1))
  done
}

render_raw_line() {
  local index="$1" row="$2" x="$3" width="$4" line="$5"
  local offset=0 rendered=0 normal="" keyword match candidate
  local style="OK"

  get_raw_line_rules "$index" "$line"
  style="$RAW_LINE_STYLE"
  if [[ -z "$RAW_LINE_KEYWORDS" ]]; then
    [[ "${PANEL_RENDER_MODES[$index]:-raw}" == "failed" ]] && style=ERROR
    frame_add "$row" "$x" "$width" "$line" "$style"
    return
  fi

  while (( offset < ${#line} && rendered < width )); do
    match=""
    for candidate in $RAW_LINE_KEYWORDS; do
      if (( ${#candidate} <= width - rendered )) &&
         [[ "${line:offset:${#candidate}}" == "$candidate" ]] &&
         (( ${#candidate} > ${#match} )); then
        match="$candidate"
      fi
    done

    if [[ -n "$match" ]]; then
      if [[ -n "$normal" ]]; then
        frame_add "$row" "$((x + rendered - ${#normal}))" "${#normal}" "$normal" OK
        normal=""
      fi
      keyword="${line:offset:${#match}}"
      frame_add "$row" "$((x + rendered))" "${#keyword}" "$keyword" "$style"
      offset=$((offset + ${#keyword}))
      rendered=$((rendered + ${#keyword}))
    else
      normal="${normal}${line:offset:1}"
      offset=$((offset + 1))
      rendered=$((rendered + 1))
    fi
  done

  if [[ -n "$normal" ]]; then
    frame_add "$row" "$((x + rendered - ${#normal}))" "${#normal}" "$normal" OK
  fi
  if (( rendered < width )); then
    frame_add "$row" "$((x + rendered))" "$((width - rendered))" "" OK
  fi
}

get_raw_line_rules() {
  local index="$1" line="$2" rules rule condition keyword

  RAW_LINE_STYLE="OK"
  RAW_LINE_KEYWORDS=""
  rules="${PANEL_ERROR_RULES[$index]:-}"
  if raw_rule_list_matches "$line" "$rules"; then
    RAW_LINE_STYLE="ERROR"
    get_raw_matching_keywords "$line" "$rules"
    return
  fi
  rules="${PANEL_WARN_RULES[$index]:-}"
  if raw_rule_list_matches "$line" "$rules"; then
    RAW_LINE_STYLE="WARN"
    get_raw_matching_keywords "$line" "$rules"
    return
  fi
  rules="${PANEL_INFO_RULES[$index]:-}"
  if raw_rule_list_matches "$line" "$rules"; then
    RAW_LINE_STYLE="INFO"
    get_raw_matching_keywords "$line" "$rules"
  fi
}

raw_rule_list_matches() {
  local value="$1" rules="$2" rule condition

  for rule in $rules; do
    condition="${rule#*:}"
    if condition_matches "$value" "$condition"; then
      return 0
    fi
  done
  return 1
}

get_raw_matching_keywords() {
  local value="$1" rules="$2" rule condition keyword result=""

  for rule in $rules; do
    condition="${rule#*:}"
    parse_condition "$condition" || continue
    [[ "$CONDITION_OPERATOR" == '~' ]] || continue
    keyword="$CONDITION_VALUE"
    condition_matches "$value" "$condition" || continue
    [[ " $result " == *" $keyword "* ]] && continue
    result="${result}${keyword} "
  done
  RAW_LINE_KEYWORDS="${result% }"
}

build_table_frame() {
  local index="$1" row=0 col width offset cell line status_line status alignment column_count=0
  ensure_effective_panel_dimensions "$index"
  local x=$((PANEL_EFFECTIVE_X[index] + 1)) y=$((PANEL_EFFECTIVE_Y[index] + 1))
  local content_width=$((PANEL_EFFECTIVE_WIDTHS[index] - 2))
  local content_height=$((PANEL_EFFECTIVE_HEIGHTS[index] - 2))

  resolve_table_widths "$index"
  for width in $RESOLVED_WIDTHS; do column_count=$((column_count + 1)); done
  while (( row < content_height )); do
    if (( row > 0 )) && [[ -z "${PANEL_TABLE_ROWS[$index]:-}" ]]; then
      if (( row == 1 )); then
        frame_add "$((y + row))" "$x" "$content_width" "No data" OK
      else
        frame_add "$((y + row))" "$x" "$content_width" "" OK
      fi
      row=$((row + 1))
      continue
    fi
    offset=0
    line=""
    status_line=""
    if (( row > 0 )); then
      get_line_at_position "${PANEL_TABLE_ROWS[$index]:-}" "$((row - 1))"
      line="$FUNCTION_RESULT"
      get_table_status_line "$index" "$row"
      status_line="$FUNCTION_RESULT"
    fi
    col=0
    for width in $RESOLVED_WIDTHS; do
      if (( row == 0 )); then
        get_word_at_position "${PANEL_TABLE_HEADERS[$index]}" "$col"
        cell="$FUNCTION_RESULT"
        status=OK
        alignment=left
      else
        get_word_at_position "$line" "$col"
        cell="$FUNCTION_RESULT"
        get_status_at_position "$status_line" "$col"
        status="$FUNCTION_RESULT"
        alignment=left
        is_number "$cell" && alignment=right
      fi
      frame_add "$((y + row))" "$((x + offset))" "$width" "$cell" "$status" "$alignment"
      offset=$((offset + width))
      if (( col < column_count - 1 )); then
        frame_add "$((y + row))" "$((x + offset))" "$TABLE_COLUMN_GAP" "" OK
        offset=$((offset + TABLE_COLUMN_GAP))
      fi
      col=$((col + 1))
    done
    if (( offset < content_width )); then
      frame_add "$((y + row))" "$((x + offset))" "$((content_width - offset))" "" OK
    fi
    row=$((row + 1))
  done
}

build_transpose_frame() {
  local index="$1" row=0 source_row=1 column_index column value status alignment line
  ensure_effective_panel_dimensions "$index"
  local x=$((PANEL_EFFECTIVE_X[index] + 1)) y=$((PANEL_EFFECTIVE_Y[index] + 1))
  local content_width=$((PANEL_EFFECTIVE_WIDTHS[index] - 2))
  local content_height=$((PANEL_EFFECTIVE_HEIGHTS[index] - 2))
  local source="${PANEL_TABLE_ROWS[$index]:-}"
  local statuses=""
  local key_width value_width

  if [[ -z "$source" ]]; then
    while (( row < content_height )); do
      if (( row == 0 )); then
        frame_add "$y" "$x" "$content_width" "No data" OK
      else
        frame_add "$((y + row))" "$x" "$content_width" "" OK
      fi
      row=$((row + 1))
    done
    return
  else
    resolve_table_widths "$index"
    get_word_at_position "$RESOLVED_WIDTHS" 0
    key_width="$FUNCTION_RESULT"
    get_word_at_position "$RESOLVED_WIDTHS" 1
    value_width="$FUNCTION_RESULT"
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    get_table_status_line "$index" "$source_row"
    statuses="$FUNCTION_RESULT"
    column_index=0
    for column in ${PANEL_TABLE_HEADERS[$index]}; do
      (( row >= content_height )) && break 2
      get_word_at_position "$line" "$column_index"
      value="$FUNCTION_RESULT"
      get_status_at_position "$statuses" "$column_index"
      status="$FUNCTION_RESULT"
      alignment=left
      is_number "$value" && alignment=right
      frame_add "$((y + row))" "$x" "$key_width" "$column" OK
      frame_add "$((y + row))" "$((x + key_width))" "$TABLE_COLUMN_GAP" "" OK
      frame_add "$((y + row))" "$((x + key_width + TABLE_COLUMN_GAP))" "$value_width" "$value" "$status" "$alignment"
      if (( key_width + TABLE_COLUMN_GAP + value_width < content_width )); then
        frame_add "$((y + row))" "$((x + key_width + TABLE_COLUMN_GAP + value_width))" "$((content_width - key_width - TABLE_COLUMN_GAP - value_width))" "" OK
      fi
      row=$((row + 1))
      column_index=$((column_index + 1))
    done
    source_row=$((source_row + 1))
  done <<< "$source"

  while (( row < content_height )); do
    frame_add "$((y + row))" "$x" "$content_width" "" OK
    row=$((row + 1))
  done
}

build_current_frame() {
  local index
  CURRENT_FRAME_KEYS=()
  CURRENT_FRAME_TEXT=()
  CURRENT_FRAME_STYLES=()
  CURRENT_FRAME_INDEX=()
  for index in "${PANEL_ORDER[@]}"; do
    case "${PANEL_RENDER_MODES[$index]:-raw}" in
      table) build_table_frame "$index" ;;
      transpose) build_transpose_frame "$index" ;;
      *) build_raw_frame "$index" ;;
    esac
  done
}

draw_static_dashboard() {
  local index title title_text title_width inner_width left_fill
  # Clear the terminal and return the cursor home for a forced full redraw.
  printf '\033[2J\033[H'
  for index in "${PANEL_ORDER[@]}"; do
    draw_panel_border "${PANEL_EFFECTIVE_X[$index]}" "${PANEL_EFFECTIVE_Y[$index]}" "${PANEL_EFFECTIVE_WIDTHS[$index]}" "${PANEL_EFFECTIVE_HEIGHTS[$index]}"
    inner_width=$((PANEL_EFFECTIVE_WIDTHS[index] - 2))
    title_width=$((inner_width - 2))
    (( title_width < 0 )) && title_width=0
    clip_text "${PANEL_TITLES[$index]}" "$title_width"
    title_text="$FUNCTION_RESULT"
    title=" ${title_text} "
    left_fill=$(((inner_width - ${#title}) / 2))
    # Move to the centered title position, leaving the remaining border dashes intact.
    move_cursor "${PANEL_EFFECTIVE_Y[$index]}" "$((PANEL_EFFECTIVE_X[index] + 1 + left_fill))"
    printf '%s' "$title"
  done
  # Move below the configured layout before drawing the static footer.
  move_cursor "$((REQUIRED_ROWS + 1))" 1
  printf 'Refresh: %ss | Press q to exit.' "$REFRESH_INTERVAL"
}

render_dashboard() {
  if (( FORCE_FULL_REDRAW == 1 )); then
    PREVIOUS_FRAME_KEYS=()
    PREVIOUS_FRAME_TEXT=()
    PREVIOUS_FRAME_STYLES=()
    PREVIOUS_FRAME_INDEX=()
    draw_static_dashboard
  fi
  build_current_frame
  render_frame_diff
  # Return the cursor to the footer after all changed cells are painted.
  move_cursor "$((REQUIRED_ROWS + 1))" 1
}

initialize_loading_dashboard() {
  local index

  PANEL_OUTPUTS=()
  PANEL_RENDER_MODES=()
  PANEL_STATUSES=()
  PANEL_TABLE_HEADERS=()
  PANEL_TABLE_ROWS=()
  PANEL_TABLE_CELL_STATUSES=()
  PANEL_SSH_FAILURE_ROWS=()

  for index in "${PANEL_ORDER[@]}"; do
    PANEL_OUTPUTS[$index]="Loading..."
    PANEL_RENDER_MODES[$index]="raw"
    PANEL_STATUSES[$index]="OK"
  done
}

get_stream_capacity() {
  local panel_index="$1"
  local capacity=$((PANEL_EFFECTIVE_HEIGHTS[panel_index] - 2))
  local layout="${PANEL_TABLE_LAYOUT[$panel_index]:-table}"

  if has_array_index PANEL_TABLE_COLUMNS "$panel_index" && [[ "$layout" == "table" ]]; then
    # Table row zero is the rendered header, so reserve one content row for it.
    capacity=$((capacity - 1))
  fi

  (( capacity < 1 )) && capacity=1
  FUNCTION_RESULT="$capacity"
}

limit_stream_output() {
  local panel_index="$1"
  local capacity content="${PANEL_OUTPUTS[$panel_index]:-}"

  get_stream_capacity "$panel_index"
  capacity="$FUNCTION_RESULT"
  if [[ -z "$content" ]]; then
    FUNCTION_RESULT=""
  else
    FUNCTION_RESULT="$(printf '%s\n' "$content" | tail -n "$capacity")"
  fi
}

stream_collect() {
  local fifo="$1"
  local snapshot_file="$2"
  local capacity="$3"
  local refresh_pid="${4:-}"
  local line temporary start position slot
  local count=0
  local next=0
  local -a lines

  lines=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    lines[$next]="$line"
    next=$(( (next + 1) % capacity ))
    if (( count < capacity )); then
      count=$((count + 1))
    fi

    temporary="${snapshot_file}.tmp"
    : >"$temporary"
    if (( count == capacity )); then
      start="$next"
    else
      start=0
    fi
    for ((position = 0; position < count; position++)); do
      slot=$(( (start + position) % capacity ))
      printf '%s\n' "${lines[$slot]}" >>"$temporary"
    done
    mv -f "$temporary" "$snapshot_file"
    if [[ -n "$refresh_pid" ]]; then
      kill -USR1 "$refresh_pid" 2>/dev/null || true
    fi
  done <"$fifo"
}

aggregate_ssh_stream_output() {
  local panel_index="$1" job alias status output line
  local aggregate="" failed=0 table_mode=0 column_count=0 column

  if has_array_index PANEL_TABLE_COLUMNS "$panel_index"; then
    table_mode=1
    for column in ${PANEL_TABLE_COLUMNS[$panel_index]}; do
      column_count=$((column_count + 1))
    done
  fi

  for ((job = 0; job < PANEL_COMMAND_JOB_COUNT; job++)); do
    [[ "${PANEL_COMMAND_PANEL_INDEXES[$job]:-}" == "$panel_index" ]] || continue
    [[ "${PANEL_COMMAND_STREAMS[$job]:-0}" -eq 1 ]] || continue
    alias="${PANEL_COMMAND_ALIASES[$job]}"
    status="$(<"${PANEL_COMMAND_STATUS_FILES[$job]}")"
    output="$(<"${PANEL_COMMAND_OUTPUT_FILES[$job]}")"

    if (( table_mode == 1 )); then
      if [[ -n "$status" && "$status" -ne 0 ]]; then
        build_ssh_synthetic_row "$alias" "SSH_FAILED" "$column_count"
        aggregate="${aggregate}${FUNCTION_RESULT}"$'\n'
        failed=1
      elif [[ -z "$output" ]]; then
        build_ssh_synthetic_row "$alias" "No_data" "$column_count"
        aggregate="${aggregate}${FUNCTION_RESULT}"$'\n'
      else
        while IFS= read -r line || [[ -n "$line" ]]; do
          [[ -z "$line" ]] && continue
          aggregate="${aggregate}${alias} ${line}"$'\n'
        done <<<"$output"
      fi
    else
      if [[ -n "$status" && "$status" -ne 0 ]]; then
        aggregate="${aggregate}${alias} SSH_FAILED (exit ${status})"$'\n'
        failed=1
      elif [[ -z "$output" ]]; then
        aggregate="${aggregate}${alias} No data"$'\n'
      else
        while IFS= read -r line || [[ -n "$line" ]]; do
          aggregate="${aggregate}${alias} ${line}"$'\n'
        done <<<"$output"
      fi
    fi
  done

  PANEL_OUTPUTS[$panel_index]="${aggregate%$'\n'}"
  limit_stream_output "$panel_index"
  PANEL_OUTPUTS[$panel_index]="$FUNCTION_RESULT"
  PANEL_SSH_FAILURE_ROWS[$panel_index]=""
  prepare_panel_output "$panel_index"
  if [[ "${PANEL_RENDER_MODES[$panel_index]:-raw}" == "table" ]]; then
    mark_ssh_failure_rows "$panel_index"
    evaluate_table_output "$panel_index"
  fi
  if (( failed == 1 )) && [[ "${PANEL_RENDER_MODES[$panel_index]}" == "raw" ]]; then
    PANEL_RENDER_MODES[$panel_index]="failed"
    PANEL_STATUSES[$panel_index]="FAILED"
  fi
}

refresh_stream_panels() {
  local panel_index job output_file current previous status last_status changed

  for panel_index in "${PANEL_ORDER[@]}"; do
    [[ "${PANEL_COMMAND_ACTIVE[$panel_index]:-0}" -eq 1 ]] || continue
    [[ "${PANEL_STREAM[$panel_index]:-0}" -eq 1 ]] || continue
    changed=0

    for ((job = 0; job < PANEL_COMMAND_JOB_COUNT; job++)); do
      [[ "${PANEL_COMMAND_PANEL_INDEXES[$job]:-}" == "$panel_index" ]] || continue
      [[ "${PANEL_COMMAND_STREAMS[$job]:-0}" -eq 1 ]] || continue
      output_file="${PANEL_COMMAND_OUTPUT_FILES[$job]}"
      [[ -f "$output_file" ]] || continue
      current="$(<"$output_file")"
      previous="${PANEL_COMMAND_LAST_OUTPUTS[$job]:-}"
      status="$(<"${PANEL_COMMAND_STATUS_FILES[$job]}")"
      last_status="${PANEL_COMMAND_LAST_STATUSES[$job]:-}"
      if [[ "$current" != "$previous" || "$status" != "$last_status" ]]; then
        PANEL_COMMAND_LAST_OUTPUTS[$job]="$current"
        PANEL_COMMAND_LAST_STATUSES[$job]="$status"
        changed=1
      fi
    done

    (( changed == 1 )) || continue
    if has_array_index PANEL_SSH_ALIASES "$panel_index"; then
      aggregate_ssh_stream_output "$panel_index"
    else
      for ((job = 0; job < PANEL_COMMAND_JOB_COUNT; job++)); do
        [[ "${PANEL_COMMAND_PANEL_INDEXES[$job]:-}" == "$panel_index" ]] || continue
        [[ "${PANEL_COMMAND_STREAMS[$job]:-0}" -eq 1 ]] || continue
        PANEL_OUTPUTS[$panel_index]="$(<"${PANEL_COMMAND_OUTPUT_FILES[$job]}")"
        limit_stream_output "$panel_index"
        PANEL_OUTPUTS[$panel_index]="$FUNCTION_RESULT"
        prepare_panel_output "$panel_index"
        break
      done
    fi
    render_dashboard
  done
}

run_panel_commands() {
  local index alias target job panel_index status_file
  local completed total now completed_panels=""

  if (( PANEL_COMMAND_SCHEDULER_INITIALIZED == 0 )); then
    PANEL_COMMAND_PIDS=()
    PANEL_COMMAND_WRAPPER_STARTS=()
    PANEL_COMMAND_CHILD_PID_FILES=()
    PANEL_COMMAND_CHILD_IDENTITY_FILES=()
    PANEL_COMMAND_COLLECTOR_PID_FILES=()
    PANEL_COMMAND_COLLECTOR_IDENTITY_FILES=()
    PANEL_COMMAND_OUTPUT_FILES=()
    PANEL_COMMAND_STATUS_FILES=()
    PANEL_COMMAND_COLLECTED=()
    PANEL_COMMAND_PANEL_INDEXES=()
    PANEL_COMMAND_ALIASES=()
    PANEL_COMMAND_TARGETS=()
    PANEL_COMMAND_INPUT_FILES=()
    PANEL_COMMAND_ERROR_FILES=()
    PANEL_COMMAND_EXIT_STATUSES=()
    PANEL_COMMAND_CONTROL_PATHS=()
    PANEL_COMMAND_STREAMS=()
    PANEL_COMMAND_FIFO_FILES=()
    PANEL_COMMAND_LAST_OUTPUTS=()
    PANEL_COMMAND_LAST_STATUSES=()
    PANEL_COMMAND_COUNTS=()
    PANEL_COMMAND_COMPLETED_COUNTS=()
    PANEL_COMMAND_ACTIVE=()
    PANEL_COMMAND_STATES=()
    PANEL_NEXT_RUN_SECONDS=()
    PANEL_COMMAND_START_JOBS=()
    PANEL_COMMAND_JOB_COUNT=0
    for index in "${PANEL_ORDER[@]}"; do
      PANEL_COMMAND_ACTIVE[$index]=0
      PANEL_NEXT_RUN_SECONDS[$index]=0
    done
    PANEL_COMMAND_SCHEDULER_INITIALIZED=1
  fi

  if [[ -z "$PANEL_COMMAND_TEMP_DIR" ]]; then
    PANEL_COMMAND_TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/lhc.commands.XXXXXX")" || {
      error "unable to create command output directory"
      return 1
    }
  fi

  now="$SECONDS"
  # Launch only panels whose own refresh timer is due. A panel remains active
  # until all of its local/SSH jobs finish, without blocking other panels.
  for index in "${PANEL_ORDER[@]}"; do
    [[ "${PANEL_COMMAND_ACTIVE[$index]:-0}" -eq 0 ]] || continue
    (( now >= ${PANEL_NEXT_RUN_SECONDS[$index]:-0} )) || continue
    PANEL_COMMAND_COUNTS[$index]=0
    PANEL_COMMAND_COMPLETED_COUNTS[$index]=0
    PANEL_COMMAND_ACTIVE[$index]=1
    PANEL_COMMAND_START_JOBS[$index]="$PANEL_COMMAND_JOB_COUNT"
    if has_array_index PANEL_SSH_ALIASES "$index"; then
      for alias in ${PANEL_SSH_ALIASES[$index]}; do
        resolve_ssh_target "$alias"
        target="$FUNCTION_RESULT"
        start_panel_command_job "$index" "$alias" "$target" || return 1
        PANEL_COMMAND_COUNTS[$index]=$((PANEL_COMMAND_COUNTS[index] + 1))
      done
    else
      start_panel_command_job "$index" "" "" || return 1
      PANEL_COMMAND_COUNTS[$index]=1
    fi
  done

  refresh_stream_panels

  # Poll portable completion markers instead of wait -n, which is unavailable
  # in the Bash version shipped with older macOS releases. One invocation is a
  # scheduler tick; the dashboard loop calls it again shortly afterward.
  for ((job = 0; job < PANEL_COMMAND_JOB_COUNT; job++)); do
    [[ "${PANEL_COMMAND_COLLECTED[$job]:-0}" -eq 1 ]] && continue
    status_file="${PANEL_COMMAND_STATUS_FILES[$job]}"
    [[ -s "$status_file" ]] || continue

    PANEL_COMMAND_STATES[$job]="EXITED"
    wait "${PANEL_COMMAND_PIDS[$job]}" 2>/dev/null || true
    PANEL_COMMAND_STATES[$job]="REAPED"
    PANEL_COMMAND_EXIT_STATUSES[$job]="$(<"$status_file")"
    PANEL_COMMAND_COLLECTED[$job]=1
    panel_index="${PANEL_COMMAND_PANEL_INDEXES[$job]}"
    completed=$((PANEL_COMMAND_COMPLETED_COUNTS[panel_index] + 1))
    PANEL_COMMAND_COMPLETED_COUNTS[$panel_index]="$completed"
    total="${PANEL_COMMAND_COUNTS[$panel_index]}"
    if (( completed == total )); then
      completed_panels="${completed_panels} ${panel_index}"
    fi
  done

  for panel_index in $completed_panels; do
    finalize_panel_command_output "$panel_index"
    PANEL_COMMAND_ACTIVE[$panel_index]=0
    PANEL_NEXT_RUN_SECONDS[$panel_index]=$((SECONDS + REFRESH_INTERVAL))
    cleanup_panel_result_files "$panel_index"
    compact_completed_panel_jobs "$panel_index"
    render_dashboard
  done

  refresh_stream_panels
}

cleanup_panel_result_files() {
  local panel_index="$1" job file

  for ((job = 0; job < PANEL_COMMAND_JOB_COUNT; job++)); do
    [[ "${PANEL_COMMAND_PANEL_INDEXES[$job]:-}" == "$panel_index" ]] || continue
    file="${PANEL_COMMAND_OUTPUT_FILES[$job]:-}"
    if [[ -n "$file" ]]; then
      rm -f "$file" "$file.tmp"
    fi
    for file in \
      "${PANEL_COMMAND_STATUS_FILES[$job]:-}" \
      "${PANEL_COMMAND_INPUT_FILES[$job]:-}" \
      "${PANEL_COMMAND_ERROR_FILES[$job]:-}" \
      "${PANEL_COMMAND_FIFO_FILES[$job]:-}" \
      "${PANEL_COMMAND_CHILD_PID_FILES[$job]:-}" \
      "${PANEL_COMMAND_CHILD_IDENTITY_FILES[$job]:-}" \
      "${PANEL_COMMAND_COLLECTOR_PID_FILES[$job]:-}" \
      "${PANEL_COMMAND_COLLECTOR_IDENTITY_FILES[$job]:-}"; do
      [[ -n "$file" ]] && rm -f "$file"
    done
  done
}

compact_completed_panel_jobs() {
  local panel_index="$1" job new_job=0
  local -a new_pids=() new_wrapper_starts=() new_child_pid_files=()
  local -a new_child_identity_files=() new_collector_pid_files=()
  local -a new_collector_identity_files=() new_output_files=()
  local -a new_status_files=() new_collected=() new_panel_indexes=()
  local -a new_aliases=() new_targets=() new_input_files=() new_error_files=()
  local -a new_exit_statuses=() new_control_paths=() new_streams=()
  local -a new_fifo_files=() new_last_outputs=() new_last_statuses=()
  local -a new_states=()

  for ((job = 0; job < PANEL_COMMAND_JOB_COUNT; job++)); do
    [[ "${PANEL_COMMAND_PANEL_INDEXES[$job]:-}" == "$panel_index" ]] && continue
    new_pids[$new_job]="${PANEL_COMMAND_PIDS[$job]:-}"
    new_wrapper_starts[$new_job]="${PANEL_COMMAND_WRAPPER_STARTS[$job]:-}"
    new_child_pid_files[$new_job]="${PANEL_COMMAND_CHILD_PID_FILES[$job]:-}"
    new_child_identity_files[$new_job]="${PANEL_COMMAND_CHILD_IDENTITY_FILES[$job]:-}"
    new_collector_pid_files[$new_job]="${PANEL_COMMAND_COLLECTOR_PID_FILES[$job]:-}"
    new_collector_identity_files[$new_job]="${PANEL_COMMAND_COLLECTOR_IDENTITY_FILES[$job]:-}"
    new_output_files[$new_job]="${PANEL_COMMAND_OUTPUT_FILES[$job]:-}"
    new_status_files[$new_job]="${PANEL_COMMAND_STATUS_FILES[$job]:-}"
    new_collected[$new_job]="${PANEL_COMMAND_COLLECTED[$job]:-}"
    new_panel_indexes[$new_job]="${PANEL_COMMAND_PANEL_INDEXES[$job]:-}"
    new_aliases[$new_job]="${PANEL_COMMAND_ALIASES[$job]:-}"
    new_targets[$new_job]="${PANEL_COMMAND_TARGETS[$job]:-}"
    new_input_files[$new_job]="${PANEL_COMMAND_INPUT_FILES[$job]:-}"
    new_error_files[$new_job]="${PANEL_COMMAND_ERROR_FILES[$job]:-}"
    new_exit_statuses[$new_job]="${PANEL_COMMAND_EXIT_STATUSES[$job]:-}"
    new_control_paths[$new_job]="${PANEL_COMMAND_CONTROL_PATHS[$job]:-}"
    new_streams[$new_job]="${PANEL_COMMAND_STREAMS[$job]:-}"
    new_fifo_files[$new_job]="${PANEL_COMMAND_FIFO_FILES[$job]:-}"
    new_last_outputs[$new_job]="${PANEL_COMMAND_LAST_OUTPUTS[$job]:-}"
    new_last_statuses[$new_job]="${PANEL_COMMAND_LAST_STATUSES[$job]:-}"
    new_states[$new_job]="${PANEL_COMMAND_STATES[$job]:-}"
    new_job=$((new_job + 1))
  done

  if (( new_job == 0 )); then
    PANEL_COMMAND_PIDS=()
    PANEL_COMMAND_WRAPPER_STARTS=()
    PANEL_COMMAND_CHILD_PID_FILES=()
    PANEL_COMMAND_CHILD_IDENTITY_FILES=()
    PANEL_COMMAND_COLLECTOR_PID_FILES=()
    PANEL_COMMAND_COLLECTOR_IDENTITY_FILES=()
    PANEL_COMMAND_OUTPUT_FILES=()
    PANEL_COMMAND_STATUS_FILES=()
    PANEL_COMMAND_COLLECTED=()
    PANEL_COMMAND_PANEL_INDEXES=()
    PANEL_COMMAND_ALIASES=()
    PANEL_COMMAND_TARGETS=()
    PANEL_COMMAND_INPUT_FILES=()
    PANEL_COMMAND_ERROR_FILES=()
    PANEL_COMMAND_EXIT_STATUSES=()
    PANEL_COMMAND_CONTROL_PATHS=()
    PANEL_COMMAND_STREAMS=()
    PANEL_COMMAND_FIFO_FILES=()
    PANEL_COMMAND_LAST_OUTPUTS=()
    PANEL_COMMAND_LAST_STATUSES=()
    PANEL_COMMAND_STATES=()
  else
    PANEL_COMMAND_PIDS=("${new_pids[@]}")
    PANEL_COMMAND_WRAPPER_STARTS=("${new_wrapper_starts[@]}")
    PANEL_COMMAND_CHILD_PID_FILES=("${new_child_pid_files[@]}")
    PANEL_COMMAND_CHILD_IDENTITY_FILES=("${new_child_identity_files[@]}")
    PANEL_COMMAND_COLLECTOR_PID_FILES=("${new_collector_pid_files[@]}")
    PANEL_COMMAND_COLLECTOR_IDENTITY_FILES=("${new_collector_identity_files[@]}")
    PANEL_COMMAND_OUTPUT_FILES=("${new_output_files[@]}")
    PANEL_COMMAND_STATUS_FILES=("${new_status_files[@]}")
    PANEL_COMMAND_COLLECTED=("${new_collected[@]}")
    PANEL_COMMAND_PANEL_INDEXES=("${new_panel_indexes[@]}")
    PANEL_COMMAND_ALIASES=("${new_aliases[@]}")
    PANEL_COMMAND_TARGETS=("${new_targets[@]}")
    PANEL_COMMAND_INPUT_FILES=("${new_input_files[@]}")
    PANEL_COMMAND_ERROR_FILES=("${new_error_files[@]}")
    PANEL_COMMAND_EXIT_STATUSES=("${new_exit_statuses[@]}")
    PANEL_COMMAND_CONTROL_PATHS=("${new_control_paths[@]}")
    PANEL_COMMAND_STREAMS=("${new_streams[@]}")
    PANEL_COMMAND_FIFO_FILES=("${new_fifo_files[@]}")
    PANEL_COMMAND_LAST_OUTPUTS=("${new_last_outputs[@]}")
    PANEL_COMMAND_LAST_STATUSES=("${new_last_statuses[@]}")
    PANEL_COMMAND_STATES=("${new_states[@]}")
  fi
  PANEL_COMMAND_JOB_COUNT=$new_job
}

get_ssh_control_path() {
  local target="$1" index

  for index in "${!SSH_CONTROL_TARGETS[@]}"; do
    if [[ "${SSH_CONTROL_TARGETS[$index]}" == "$target" ]]; then
      FUNCTION_RESULT="${SSH_CONTROL_PATHS[$index]}"
      return 0
    fi
  done

  index="${#SSH_CONTROL_TARGETS[@]}"
  SSH_CONTROL_TARGETS[$index]="$target"
  SSH_CONTROL_PATHS[$index]="$PANEL_COMMAND_TEMP_DIR/control.$index"
  FUNCTION_RESULT="${SSH_CONTROL_PATHS[$index]}"
}

start_panel_command_job() {
  local panel_index="$1" alias="$2" target="$3"
  local job="$PANEL_COMMAND_JOB_COUNT"
  local output_file="$PANEL_COMMAND_TEMP_DIR/output.$job"
  local status_file="$PANEL_COMMAND_TEMP_DIR/status.$job"
  local input_file="$PANEL_COMMAND_TEMP_DIR/input.$job"
  local error_file="$PANEL_COMMAND_TEMP_DIR/error.$job"
  local fifo_file="$PANEL_COMMAND_TEMP_DIR/fifo.$job"
  local child_pid_file="$PANEL_COMMAND_TEMP_DIR/child.$job"
  local child_identity_file="$PANEL_COMMAND_TEMP_DIR/child-identity.$job"
  local collector_pid_file="$PANEL_COMMAND_TEMP_DIR/collector.$job"
  local collector_identity_file="$PANEL_COMMAND_TEMP_DIR/collector-identity.$job"
  local control_path=""
  local stream_mode="${PANEL_STREAM[$panel_index]:-0}"
  local stream_capacity=""

  if [[ "$stream_mode" == "1" ]]; then
    get_stream_capacity "$panel_index"
    stream_capacity="$FUNCTION_RESULT"
    if ! mkfifo "$fifo_file"; then
      error "unable to create stream FIFO for panel $panel_index"
      return 1
    fi
    : >"$output_file"
  fi

  PANEL_COMMAND_JOB_COUNT=$((PANEL_COMMAND_JOB_COUNT + 1))
  PANEL_COMMAND_PANEL_INDEXES[$job]="$panel_index"
  PANEL_COMMAND_WRAPPER_STARTS[$job]=""
  PANEL_COMMAND_CHILD_PID_FILES[$job]="$child_pid_file"
  PANEL_COMMAND_CHILD_IDENTITY_FILES[$job]="$child_identity_file"
  PANEL_COMMAND_COLLECTOR_PID_FILES[$job]="$collector_pid_file"
  PANEL_COMMAND_COLLECTOR_IDENTITY_FILES[$job]="$collector_identity_file"
  PANEL_COMMAND_ALIASES[$job]="$alias"
  PANEL_COMMAND_TARGETS[$job]="$target"
  PANEL_COMMAND_OUTPUT_FILES[$job]="$output_file"
  PANEL_COMMAND_STATUS_FILES[$job]="$status_file"
  PANEL_COMMAND_ERROR_FILES[$job]="$error_file"
  PANEL_COMMAND_CONTROL_PATHS[$job]=""
  PANEL_COMMAND_STREAMS[$job]="$stream_mode"
  PANEL_COMMAND_FIFO_FILES[$job]=""
  PANEL_COMMAND_LAST_OUTPUTS[$job]=""
  PANEL_COMMAND_LAST_STATUSES[$job]=""
  PANEL_COMMAND_STATES[$job]="STARTING"
  : >"$status_file"
  : >"$error_file"
  : >"$child_pid_file"
  : >"$child_identity_file"
  : >"$collector_pid_file"
  : >"$collector_identity_file"

  if [[ "$stream_mode" == "1" ]]; then
    PANEL_COMMAND_FIFO_FILES[$job]="$fifo_file"
  fi

  if [[ -n "$alias" ]]; then
    get_ssh_control_path "$target"
    control_path="$FUNCTION_RESULT"
    PANEL_COMMAND_CONTROL_PATHS[$job]="$control_path"
    PANEL_COMMAND_INPUT_FILES[$job]="$input_file"
    printf '%s\n' "${PANEL_COMMANDS[$panel_index]}" >"$input_file"
  fi

  (
    local child_pid="" collector_pid="" exit_status output_target refresh_pid="${STREAM_REFRESH_PID:-}"

    terminate_job_process() {
      local process_pid="$1" attempt
      [[ -n "$process_pid" ]] || return 0
      kill -TERM "$process_pid" 2>/dev/null || true
      for ((attempt = 0; attempt < JOB_TERM_GRACE_ATTEMPTS; attempt++)); do
        kill -0 "$process_pid" 2>/dev/null || return 0
        sleep "$JOB_GRACE_SLEEP"
      done
      kill -KILL "$process_pid" 2>/dev/null || true
    }

    handle_job_signal() {
      terminate_job_process "$child_pid"
      terminate_job_process "$collector_pid"
      exit 143
    }
    trap handle_job_signal TERM INT

    output_target="$output_file"
    if [[ "$stream_mode" == "1" ]]; then
      stream_collect "$fifo_file" "$output_file" "$stream_capacity" "$refresh_pid" &
      collector_pid=$!
      printf '%s\n' "$collector_pid" >"$collector_pid_file"
      get_process_identity "$collector_pid" >"$collector_identity_file"
      output_target="$fifo_file"
    fi

    if [[ -n "$alias" ]]; then
      ssh -T \
        -o BatchMode=yes \
        -o ConnectTimeout=10 \
        -o StrictHostKeyChecking=yes \
        -o ControlMaster=auto \
        -o ControlPersist="${SSH_CONTROL_PERSIST_SECONDS}" \
        -o ControlPath="$control_path" \
        "$target" bash -s <"$input_file" >"$output_target" 2>"$error_file" &
    else
      bash -c "${PANEL_COMMANDS[$panel_index]}" >"$output_target" 2>"$error_file" &
    fi
    child_pid=$!
    printf '%s\n' "$child_pid" >"$child_pid_file"
    get_process_identity "$child_pid" >"$child_identity_file"
    wait "$child_pid"
    exit_status=$?
    if [[ "$stream_mode" == "1" ]]; then
      wait "$collector_pid" 2>/dev/null || true
    fi
    trap - TERM INT
    printf '%s\n' "$exit_status" >"$status_file"
    if [[ "$stream_mode" == "1" && -n "$refresh_pid" ]]; then
      kill -USR1 "$refresh_pid" 2>/dev/null || true
    fi
  ) &
  PANEL_COMMAND_PIDS[$job]=$!
  PANEL_COMMAND_WRAPPER_STARTS[$job]="$(get_process_identity "${PANEL_COMMAND_PIDS[$job]}")"
  PANEL_COMMAND_STATES[$job]="RUNNING"
}

finalize_panel_command_output() {
  local panel_index="$1" job exit_status output_file

  if has_array_index PANEL_SSH_ALIASES "$panel_index"; then
    aggregate_ssh_panel_output "$panel_index"
    return
  fi

  for ((job = 0; job < PANEL_COMMAND_JOB_COUNT; job++)); do
    [[ "${PANEL_COMMAND_PANEL_INDEXES[$job]:-}" == "$panel_index" ]] || continue
    exit_status="${PANEL_COMMAND_EXIT_STATUSES[$job]}"
    output_file="${PANEL_COMMAND_OUTPUT_FILES[$job]}"
    if [[ "$exit_status" -eq 0 ]]; then
      PANEL_OUTPUTS[$panel_index]="$(<"$output_file")"
      if [[ "${PANEL_COMMAND_STREAMS[$job]:-0}" -eq 1 ]]; then
        limit_stream_output "$panel_index"
        PANEL_OUTPUTS[$panel_index]="$FUNCTION_RESULT"
      fi
      prepare_panel_output "$panel_index"
    elif [[ "${PANEL_COMMAND_STREAMS[$job]:-0}" -eq 1 && -s "$output_file" ]]; then
      # Keep the final stream window visible while marking the panel failed.
      PANEL_OUTPUTS[$panel_index]="$(<"$output_file")"
      limit_stream_output "$panel_index"
      PANEL_OUTPUTS[$panel_index]="$FUNCTION_RESULT"
      prepare_panel_output "$panel_index"
      PANEL_RENDER_MODES[$panel_index]="failed"
      PANEL_STATUSES[$panel_index]="FAILED"
    else
      PANEL_OUTPUTS[$panel_index]="Command failed"
      PANEL_RENDER_MODES[$panel_index]="failed"
      PANEL_STATUSES[$panel_index]="FAILED"
    fi
    return
  done
}

aggregate_ssh_panel_output() {
  local panel_index="$1" job alias exit_status output line
  local aggregate="" failed=0
  local table_mode=0 column_count=0 column

  if has_array_index PANEL_TABLE_COLUMNS "$panel_index"; then
    table_mode=1
    for column in ${PANEL_TABLE_COLUMNS[$panel_index]}; do
      column_count=$((column_count + 1))
    done
  fi

  for ((job = 0; job < PANEL_COMMAND_JOB_COUNT; job++)); do
    [[ "${PANEL_COMMAND_PANEL_INDEXES[$job]:-}" == "$panel_index" ]] || continue
    alias="${PANEL_COMMAND_ALIASES[$job]}"
    exit_status="${PANEL_COMMAND_EXIT_STATUSES[$job]}"
    output="$(<"${PANEL_COMMAND_OUTPUT_FILES[$job]}")"

    if (( table_mode == 1 )); then
      if [[ "$exit_status" -ne 0 ]]; then
        build_ssh_synthetic_row "$alias" "SSH_FAILED" "$column_count"
        aggregate="${aggregate}${FUNCTION_RESULT}"$'\n'
        failed=1
      elif [[ -z "$output" ]]; then
        build_ssh_synthetic_row "$alias" "No_data" "$column_count"
        aggregate="${aggregate}${FUNCTION_RESULT}"$'\n'
      else
        while IFS= read -r line || [[ -n "$line" ]]; do
          [[ -z "$line" ]] && continue
          aggregate="${aggregate}${alias} ${line}"$'\n'
        done <<< "$output"
      fi
    else
      if [[ "$exit_status" -ne 0 ]]; then
        aggregate="${aggregate}${alias} SSH_FAILED (exit ${exit_status})"$'\n'
        failed=1
      elif [[ -z "$output" ]]; then
        aggregate="${aggregate}${alias} No data"$'\n'
      else
        while IFS= read -r line || [[ -n "$line" ]]; do
          aggregate="${aggregate}${alias} ${line}"$'\n'
        done <<< "$output"
      fi
    fi
  done

  PANEL_OUTPUTS[$panel_index]="${aggregate%$'\n'}"
  if [[ "${PANEL_STREAM[$panel_index]:-0}" -eq 1 ]]; then
    limit_stream_output "$panel_index"
    PANEL_OUTPUTS[$panel_index]="$FUNCTION_RESULT"
  fi
  PANEL_SSH_FAILURE_ROWS[$panel_index]=""
  prepare_panel_output "$panel_index"
  if [[ "${PANEL_RENDER_MODES[$panel_index]:-raw}" == "table" ]]; then
    mark_ssh_failure_rows "$panel_index"
    evaluate_table_output "$panel_index"
  fi
  if (( failed == 1 )) && [[ "${PANEL_RENDER_MODES[$panel_index]}" == "raw" ]]; then
    PANEL_RENDER_MODES[$panel_index]="failed"
    PANEL_STATUSES[$panel_index]="FAILED"
  fi
}

build_ssh_synthetic_row() {
  local alias="$1" marker="$2" column_count="$3" position=2 row

  row="$alias $marker"
  while (( position < column_count )); do
    row="${row} -"
    position=$((position + 1))
  done
  FUNCTION_RESULT="$row"
}

mark_ssh_failure_rows() {
  local index="$1" row=1 line marker failure_rows=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    get_word_at_position "$line" 1
    marker="$FUNCTION_RESULT"
    if [[ "$marker" == "SSH_FAILED" ]]; then
      failure_rows="${failure_rows}${row} "
    fi
    row=$((row + 1))
  done <<< "${PANEL_TABLE_ROWS[$index]:-}"

  PANEL_SSH_FAILURE_ROWS[$index]="${failure_rows% }"
}

prepare_panel_output() {
  local index="$1"

  PANEL_RENDER_MODES[$index]="raw"
  PANEL_STATUSES[$index]="OK"

  if has_array_index PANEL_TABLE_COLUMNS "$index"; then
    parse_table_output "$index" || return 0
    evaluate_table_output "$index"
  elif [[ -z "${PANEL_OUTPUTS[$index]}" ]]; then
    PANEL_OUTPUTS[$index]="No data"
  fi
}

parse_table_output() {
  local index="$1"
  local output="${PANEL_OUTPUTS[$index]}"
  local columns="${PANEL_TABLE_COLUMNS[$index]}"
  local column_count=0
  local row_field_count
  local line
  local field
  local table_rows=""

  for line in $columns; do
    column_count=$((column_count + 1))
  done

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    row_field_count=0
    for field in $line; do
      row_field_count=$((row_field_count + 1))
    done

    if (( row_field_count != column_count )); then
      PANEL_RENDER_MODES[$index]="raw"
      PANEL_STATUSES[$index]="OK"
      return 1
    fi

    table_rows="${table_rows}${line}"$'\n'
  done <<< "$output"

  PANEL_RENDER_MODES[$index]="${PANEL_TABLE_LAYOUT[$index]:-table}"
  PANEL_TABLE_HEADERS[$index]="$columns"
  PANEL_TABLE_ROWS[$index]="${table_rows%$'\n'}"
}

evaluate_table_output() {
  local index="$1"
  local line
  local row=1
  local col
  local cell
  local column
  local cell_status
  local status_line
  local status_rows=""
  local panel_status="OK"

  while IFS= read -r line || [[ -n "$line" ]]; do
    col=0
    status_line=""
    for cell in $line; do
      if is_ssh_failure_row "$index" "$row"; then
        cell_status="ERROR"
      else
        get_column_at_position "$index" "$col"
        column="$FUNCTION_RESULT"
        evaluate_cell "$index" "$column" "$cell"
        cell_status="$FUNCTION_RESULT"
      fi
      status_line="${status_line}${cell_status} "
      worst_status "$panel_status" "$cell_status"
      panel_status="$FUNCTION_RESULT"
      col=$((col + 1))
    done

    status_rows="${status_rows}${status_line% }"$'\n'
    row=$((row + 1))
  done <<< "${PANEL_TABLE_ROWS[$index]}"

  PANEL_TABLE_CELL_STATUSES[$index]="${status_rows%$'\n'}"
  PANEL_STATUSES[$index]="$panel_status"
}

is_ssh_failure_row() {
  local index="$1" row="$2"
  [[ " ${PANEL_SSH_FAILURE_ROWS[$index]:-} " == *" $row "* ]]
}

get_column_at_position() {
  local index="$1"
  local target="$2"
  local position=0
  local column

  FUNCTION_RESULT=""
  for column in ${PANEL_TABLE_COLUMNS[$index]}; do
    if (( position == target )); then
      FUNCTION_RESULT="$column"
      return 0
    fi
    position=$((position + 1))
  done
}

get_table_status_line() {
  local index="$1"
  local row="$2"
  local current_row=1
  local line

  FUNCTION_RESULT=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if (( current_row == row )); then
      FUNCTION_RESULT="$line"
      return 0
    fi
    current_row=$((current_row + 1))
  done <<< "${PANEL_TABLE_CELL_STATUSES[$index]:-}"
}

get_status_at_position() {
  local status_line="$1"
  local target="$2"
  local position=0
  local status

  FUNCTION_RESULT="OK"
  for status in $status_line; do
    if (( position == target )); then
      FUNCTION_RESULT="$status"
      return 0
    fi
    position=$((position + 1))
  done

}

evaluate_cell() {
  local index="$1"
  local column="$2"
  local value="$3"

  if rule_list_matches "$value" "$column" "${PANEL_ERROR_RULES[$index]:-}"; then
    FUNCTION_RESULT="ERROR"
    return 0
  fi

  if rule_list_matches "$value" "$column" "${PANEL_WARN_RULES[$index]:-}"; then
    FUNCTION_RESULT="WARN"
    return 0
  fi

  if rule_list_matches "$value" "$column" "${PANEL_INFO_RULES[$index]:-}"; then
    FUNCTION_RESULT="INFO"
    return 0
  fi

  FUNCTION_RESULT="OK"
}

rule_list_matches() {
  local value="$1"
  local target_column="$2"
  local rules="$3"
  local rule
  local column
  local condition

  for rule in $rules; do
    column="${rule%%:*}"
    condition="${rule#*:}"
    if [[ "$column" == "$target_column" ]] && condition_matches "$value" "$condition"; then
      return 0
    fi
  done

  return 1
}

condition_matches() {
  local value="$1"
  local condition="$2"
  local operator
  local expected

  parse_condition "$condition" || return 1
  operator="$CONDITION_OPERATOR"
  expected="$CONDITION_VALUE"

  case "$operator" in
    '~'|'!~')
      if [[ "$value" == *"$expected"* ]]; then
        [[ "$operator" == '~' ]]
      else
        [[ "$operator" == '!~' ]]
      fi
      ;;
    '=='|'!=')
      if is_number "$value" && is_number "$expected"; then
        compare_numbers "$value" "$operator" "$expected"
      elif [[ "$operator" == '==' ]]; then
        [[ "$value" == "$expected" ]]
      else
        [[ "$value" != "$expected" ]]
      fi
      ;;
    '>'|'>='|'<'|'<=')
      is_number "$value" && is_number "$expected" && compare_numbers "$value" "$operator" "$expected"
      ;;
    *) return 1 ;;
  esac
}

is_number() {
  [[ "$1" =~ ^-?[0-9]+([.][0-9]+)?$ ]]
}

compare_numbers() {
  local left="$1"
  local operator="$2"
  local right="$3"

  compare_decimal_values "$left" "$right"
  case "$operator" in
    '>')  (( NUMERIC_COMPARE > 0 )) ;;
    '>=') (( NUMERIC_COMPARE >= 0 )) ;;
    '<')  (( NUMERIC_COMPARE < 0 )) ;;
    '<=') (( NUMERIC_COMPARE <= 0 )) ;;
    '==') (( NUMERIC_COMPARE == 0 )) ;;
    '!=') (( NUMERIC_COMPARE != 0 )) ;;
    *) return 1 ;;
  esac
}

compare_decimal_values() {
  local left="$1" right="$2" left_sign=1 right_sign=1
  local left_integer left_fraction right_integer right_fraction length
  local LC_ALL=C

  [[ "$left" == -* ]] && left_sign=-1 && left="${left#-}"
  [[ "$right" == -* ]] && right_sign=-1 && right="${right#-}"
  left_integer="${left%%.*}"
  right_integer="${right%%.*}"
  [[ "$left" == *.* ]] && left_fraction="${left#*.}" || left_fraction=""
  [[ "$right" == *.* ]] && right_fraction="${right#*.}" || right_fraction=""
  while [[ "${left_integer#0}" != "$left_integer" ]]; do left_integer="${left_integer#0}"; done
  while [[ "${right_integer#0}" != "$right_integer" ]]; do right_integer="${right_integer#0}"; done
  [[ -n "$left_integer" ]] || left_integer=0
  [[ -n "$right_integer" ]] || right_integer=0
  [[ "$left_integer$left_fraction" =~ ^0+$ ]] && left_sign=1
  [[ "$right_integer$right_fraction" =~ ^0+$ ]] && right_sign=1

  if (( left_sign != right_sign )); then
    NUMERIC_COMPARE=$left_sign
    return
  fi
  if (( ${#left_integer} != ${#right_integer} )); then
    (( ${#left_integer} > ${#right_integer} )) && NUMERIC_COMPARE=1 || NUMERIC_COMPARE=-1
  elif [[ "$left_integer" == "$right_integer" ]]; then
    length=${#left_fraction}
    (( ${#right_fraction} > length )) && length=${#right_fraction}
    while (( ${#left_fraction} < length )); do left_fraction="${left_fraction}0"; done
    while (( ${#right_fraction} < length )); do right_fraction="${right_fraction}0"; done
    if [[ "$left_fraction" == "$right_fraction" ]]; then
      NUMERIC_COMPARE=0
    elif [[ "$left_fraction" > "$right_fraction" ]]; then
      NUMERIC_COMPARE=1
    else
      NUMERIC_COMPARE=-1
    fi
  elif [[ "$left_integer" > "$right_integer" ]]; then
    NUMERIC_COMPARE=1
  else
    NUMERIC_COMPARE=-1
  fi
  (( left_sign < 0 )) && NUMERIC_COMPARE=$((-NUMERIC_COMPARE))
}

worst_status() {
  local current="$1"
  local candidate="$2"

  if [[ "$current" == "ERROR" || "$candidate" == "ERROR" ]]; then
    FUNCTION_RESULT="ERROR"
  elif [[ "$current" == "WARN" || "$candidate" == "WARN" ]]; then
    FUNCTION_RESULT="WARN"
  elif [[ "$current" == "INFO" || "$candidate" == "INFO" ]]; then
    FUNCTION_RESULT="INFO"
  else
    FUNCTION_RESULT="OK"
  fi
}

wait_for_quit_or_timeout() {
  local timeout="$1"
  local key

  if IFS= read -rsn1 -t "$timeout" key; then
    [[ "$key" == "q" ]]
    return
  fi

  # A stream refresh signal can interrupt the blocking read. Check stdin once
  # more without blocking so a q that arrived with the signal is handled
  # before the event loop starts another refresh cycle.
  if IFS= read -rsn1 -t 0 key; then
    [[ "$key" == "q" ]]
    return
  fi

  return 1
}

show_resize_pause() {
  # Clear the dashboard and return the cursor home for the resize message.
  printf '\033[2J\033[H'
  if [[ -n "$LAYOUT_ERROR" ]]; then
    printf 'Layout invalid: %s Resize or press q to exit.' "$LAYOUT_ERROR"
  else
    printf 'Terminal too small: need %sx%s, have %sx%s. Resize or press q to exit.' \
      "$REQUIRED_COLS" "$REQUIRED_TERMINAL_ROWS" "$TERMINAL_COLS" "$TERMINAL_ROWS"
  fi
}

process_terminal_resize() {
  read_terminal_size || return 1
  resolve_panel_dimensions
  calculate_required_terminal_size
  RESIZE_PENDING=0
  LAYOUT_ERROR=""

  if (( TERMINAL_COLS < REQUIRED_COLS || TERMINAL_ROWS < REQUIRED_TERMINAL_ROWS )); then
    if (( DASHBOARD_PAUSED == 0 )); then
      show_resize_pause
    fi
    DASHBOARD_PAUSED=1
    return 1
  fi

  if ! validate_effective_panel_layout; then
    if (( DASHBOARD_PAUSED == 0 )); then
      show_resize_pause
    fi
    DASHBOARD_PAUSED=1
    return 1
  fi

  if (( DASHBOARD_PAUSED == 1 )); then
    DASHBOARD_PAUSED=0
  fi

  # Resize changes the visible stream window. Trim the already aggregated
  # output immediately so a smaller panel continues to show its newest lines.
  local panel_index
  for panel_index in "${PANEL_ORDER[@]}"; do
    [[ "${PANEL_COMMAND_ACTIVE[$panel_index]:-0}" -eq 1 ]] || continue
    [[ "${PANEL_STREAM[$panel_index]:-0}" -eq 1 ]] || continue
    if has_array_index PANEL_SSH_ALIASES "$panel_index"; then
      aggregate_ssh_stream_output "$panel_index"
    else
      limit_stream_output "$panel_index"
      PANEL_OUTPUTS[$panel_index]="$FUNCTION_RESULT"
      prepare_panel_output "$panel_index"
    fi
  done

  FORCE_FULL_REDRAW=1
  render_dashboard
  return 0
}

run_dashboard_loop() {
  while true; do
    if (( RESIZE_PENDING == 1 || DASHBOARD_PAUSED == 1 )); then
      process_terminal_resize || true
    fi

    if (( DASHBOARD_PAUSED == 1 )); then
      if wait_for_quit_or_timeout 1; then
        return 0
      fi
      continue
    fi

    run_panel_commands

    # A stream collector interrupts the keyboard wait through SIGUSR1. Consume
    # the coalesced notification with a non-blocking keyboard check, then
    # briefly yield before the next scheduler tick. The continue is therefore
    # never a path that bypasses input handling or creates a hot loop.
    if (( STREAM_REFRESH_PENDING == 1 )); then
      STREAM_REFRESH_PENDING=0
      if wait_for_quit_or_timeout 0; then
        return 0
      fi
      sleep "$STREAM_EVENT_SLEEP"
      continue
    fi

    if wait_for_quit_or_timeout 1; then
      return 0
    fi
  done
}

main() {
  case "${1:-}" in
    -h|--help|--usage)
      usage
      return 0
      ;;
  esac

  local config_file="${1:-$DEFAULT_CONFIG}"

  if ! load_config "$config_file"; then
    return 1
  fi

  if ! validate_terminal_size; then
    return 1
  fi

  trap cleanup_terminal EXIT
  trap handle_interrupt INT
  trap handle_resize WINCH
  STREAM_REFRESH_PID="$$"
  trap handle_stream_refresh USR1

  setup_terminal
  initialize_loading_dashboard
  render_dashboard
  run_dashboard_loop
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
