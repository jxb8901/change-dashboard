#!/usr/bin/env bash

set -u

if [[ -n "${FAKE_SSH_LOG:-}" ]]; then
  printf '%s\n' "$*" >>"$FAKE_SSH_LOG"
fi
if [[ -n "${FAKE_SSH_PID_FILE:-}" ]]; then
  printf 'fake-ssh:%s\n' "$$" >>"$FAKE_SSH_PID_FILE"
  printf 'wrapper:%s\n' "$PPID" >>"$FAKE_SSH_PID_FILE"
fi

target=""
operation=""
control_path=""
control_master=""
master_request=0
while (( $# > 0 )); do
  case "$1" in
    -M|-MNf)
      master_request=1
      shift
      ;;
    -N|-f)
      shift
      ;;
    -T)
      shift
      ;;
    -o)
      (( $# >= 2 )) || exit 64
      case "$2" in
        ControlMaster=*) control_master="${2#ControlMaster=}" ;;
        ControlPath=*) control_path="${2#ControlPath=}" ;;
      esac
      shift 2
      ;;
    -O)
      (( $# >= 2 )) || exit 64
      operation="$2"
      shift 2
      ;;
    *)
      target="$1"
      shift
      break
      ;;
  esac
done

[[ -n "$target" ]] || exit 64
if [[ "$operation" == "exit" ]]; then
  [[ -n "$control_path" ]] && rm -rf "${control_path}.fake-state"
  exit 0
fi
if [[ "$operation" == "check" ]]; then
  if [[ -n "$control_path" && -d "${control_path}.fake-state" ]]; then
    [[ -n "$FAKE_SSH_LOG" ]] && printf 'check %s %s\n' "$target" "$control_path" >>"$FAKE_SSH_LOG"
    if [[ -n "${FAKE_SSH_DROP_MASTER_AFTER_CHECK_FILE:-}" &&
      -e "$FAKE_SSH_DROP_MASTER_AFTER_CHECK_FILE" ]]; then
      rm -f "$FAKE_SSH_DROP_MASTER_AFTER_CHECK_FILE"
      rm -rf "${control_path}.fake-state"
    fi
    exit 0
  fi
  exit 255
fi
if (( master_request == 1 )); then
  [[ -n "$control_path" ]] || exit 64
  if [[ -n "${FAKE_SSH_MASTER_DELAY_SECONDS:-}" ]]; then
    sleep "$FAKE_SSH_MASTER_DELAY_SECONDS"
  fi
  if [[ -n "${FAKE_SSH_MASTER_DELAY_FILE:-}" &&
    -e "$FAKE_SSH_MASTER_DELAY_FILE" ]]; then
    sleep "${FAKE_SSH_MASTER_DELAY_FILE_SECONDS:-1}"
  fi
  if [[ "${FAKE_SSH_MASTER_FAIL_TARGET:-}" == "$target" ]]; then
    exit 255
  fi
  mkdir -p "${control_path}.fake-state" 2>/dev/null || exit 255
  [[ -n "$FAKE_SSH_LOG" ]] && printf 'master %s %s\n' "$target" "$control_path" >>"$FAKE_SSH_LOG"
  exit 0
fi
[[ "${1:-}" == "bash" && "${2:-}" == "-s" ]] || exit 64

if [[ "$control_master" == "no" && "$control_path" != "none" ]]; then
  if [[ ! -d "${control_path}.fake-state" ]]; then
    [[ "${FAKE_SSH_ALLOW_CHANNEL_FALLBACK:-0}" == "1" ]] || exit 255
    [[ -n "$FAKE_SSH_LOG" ]] && printf 'fallback %s %s\n' "$target" "$control_path" >>"$FAKE_SSH_LOG"
  fi
  [[ -n "$FAKE_SSH_LOG" ]] && printf 'channel %s %s\n' "$target" "$control_path" >>"$FAKE_SSH_LOG"
  if [[ -n "${FAKE_SSH_DROP_FIRST_CHANNEL_FILE:-}" && ! -e "$FAKE_SSH_DROP_FIRST_CHANNEL_FILE" ]]; then
    : >"$FAKE_SSH_DROP_FIRST_CHANNEL_FILE"
    rm -rf "${control_path}.fake-state"
    exit 255
  fi
else
  [[ -n "$FAKE_SSH_LOG" ]] && printf 'dedicated %s\n' "$target" >>"$FAKE_SSH_LOG"
fi

if [[ "$target" == "fail" ]]; then
  exit 255
fi

export FAKE_SSH_TARGET="$target"
remote_pid=""
forward_signal() {
  if [[ -n "$remote_pid" ]]; then
    kill -TERM "$remote_pid" 2>/dev/null || true
    kill -KILL "$remote_pid" 2>/dev/null || true
  fi
  exit 143
}
trap forward_signal TERM INT
bash -s <&0 &
remote_pid=$!
wait "$remote_pid"
exit_status=$?
trap - TERM INT
exit "$exit_status"
